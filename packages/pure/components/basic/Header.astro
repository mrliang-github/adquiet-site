---
// 引入全局配置 virtual:config
import config from 'virtual:config'
// 引入 Astro 官方图片组件，用于优化微头像渲染
import { Image } from 'astro:assets'
// 引入良逍专属头像资源
import avatarImg from '@/assets/avatar.png'
// 引入纯粹主题的通用 Icon 图标组件
import { Icon } from '../user'
---

{/* 顶部主导航容器：支持平滑吸顶悬浮、现代毛玻璃特效与统一边框规范 */}
<header-component
  class='group sticky top-3 sm:top-4 z-50 max-md:z-30 mb-8 sm:mb-10 flex items-center justify-between rounded-2xl border border-transparent px-3 py-2 transition-all duration-300 sm:px-4'
>
  {/* 左侧个人品牌 Logo：展示微型圆角头像 + 精炼的作者名称，彻底解决整站标题过长拥挤问题 */}
  <a
    class='z-30 flex items-center gap-x-2.5 rounded-full text-base font-semibold tracking-tight text-foreground transition-all duration-200 hover:opacity-80 sm:text-lg'
    href='/'
    aria-label={`${config.author} 个人主页`}
  >
    {/* 微型头像容器：带环形细边框与柔和阴影 */}
    <div class='relative flex size-7 items-center justify-center overflow-hidden rounded-full ring-1 ring-border/80 transition-transform duration-300 hover:scale-105 sm:size-8'>
      <Image
        src={avatarImg}
        alt={config.author}
        class='size-full object-cover'
        loading='eager'
      />
    </div>
    <span class='font-medium text-foreground'>{config.author}</span>
  </a>

  {/* 中间与右侧功能区容器 */}
  <div class='flex items-center gap-x-2 sm:gap-x-3'>
    {/* 桌面端居中/右侧主导航链接（在 640px 以上展示） */}
    <nav
      class='hidden items-center gap-x-1 sm:flex'
      aria-label='站点主导航'
    >
      {
        config.header.menu.map((item) => (
          <a
            href={item.link}
            class='rounded-lg px-2.5 py-1.5 text-sm font-medium text-muted-foreground transition-all duration-200 hover:bg-muted/70 hover:text-foreground md:px-3'
            aria-label={item.title}
            data-astro-prefetch
          >
            {item.title}
          </a>
        ))
      }
    </nav>

    {/* 右侧交互操作按钮组：搜索入口、明暗模式切换、移动端汉堡折叠按钮 */}
    <div class='z-30 flex items-center gap-x-1.5 sm:gap-x-2'>
      {/* 搜索入口按钮 */}
      <a
        href='/search'
        class='flex size-8.5 items-center justify-center rounded-lg border border-border/70 text-muted-foreground transition-all duration-200 hover:border-primary/40 hover:bg-muted hover:text-foreground'
        title='全站检索 (Search)'
        aria-label='全站检索'
      >
        <span class='sr-only'>搜索</span>
        <Icon name='search' class='size-4' />
      </a>

      {/* 明暗模式切换按钮 */}
      <button
        id='toggleDarkMode'
        class='group/dark flex size-8.5 items-center justify-center rounded-lg border border-border/70 text-muted-foreground transition-all duration-200 hover:border-primary/40 hover:bg-muted hover:text-foreground'
        aria-label='切换颜色模式'
      >
        <span class='sr-only'>切换深色/浅色模式</span>
        <Icon class='system size-4 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-4 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-4 group-hover/dark:text-primary' name='moon' />
      </button>

      {/* 移动端汉堡折叠菜单切换按钮（仅在小于 640px 屏宽展示） */}
      <button
        id='toggleMenu'
        class='flex size-8.5 items-center justify-center rounded-lg border border-border/70 text-muted-foreground transition-all duration-200 hover:border-primary/40 hover:bg-muted hover:text-foreground sm:hidden'
        aria-label='展开移动端导航菜单'
      >
        <span class='sr-only'>展开菜单</span>
        <Icon class='size-4' name='menu' />
      </button>
    </div>

    {/* 移动端展开抽屉式菜单：毛玻璃背景与圆角卡片布局 */}
    <div
      id='headerExpandContent'
      class='absolute inset-x-0 top-[calc(100%+0.5rem)] z-40 rounded-2xl border border-border/80 bg-background/95 p-3 shadow-xl backdrop-blur-md max-sm:opacity-0 max-sm:pointer-events-none group-[.expanded]:max-sm:opacity-100 group-[.expanded]:max-sm:pointer-events-auto sm:hidden transition-all duration-200'
    >
      <div class='flex flex-col gap-y-1 overflow-hidden'>
        {
          config.header.menu.map((item) => (
            <a
              href={item.link}
              class='flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted/70'
              aria-label={item.title}
              data-astro-prefetch
            >
              <span>{item.title}</span>
              <span class='font-mono text-xs text-muted-foreground'>→</span>
            </a>
          ))
        }
        <a
          href='/search'
          class='mt-1 flex items-center justify-between border-t border-border/60 px-3 pt-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground'
          aria-label='移动端全站检索'
        >
          <span class='flex items-center gap-x-2'>
            <Icon name='search' class='size-4' />
            搜索全站文章与资源
          </span>
          <span class='font-mono text-xs text-muted-foreground'>Search</span>
        </a>
      </div>
    </div>
  </div>
</header-component>

{/* 内联快速获取本地偏好主题，避免页面初次载入时闪烁 */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>

{/* Header 自定义组件逻辑：监听滚动状态与主题切换 */}
<script>
  import { setTheme, showToast } from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      // 记录初始滚动距离并初始化吸顶状态
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)

      // 监听滚动事件：动态切换吸顶样式与上滑隐藏/下滑展示
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // 暗黑模式切换事件绑定与本地化反馈提示
      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn?.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        const themeLabel = newTheme === 'dark' ? '深色模式' : newTheme === 'light' ? '浅色模式' : '跟随系统'
        showToast({ message: `主题已切换至 ${themeLabel}` })
      })

      // 移动端折叠菜单开关事件
      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
      })

      // 点击移动端菜单项后自动收起菜单
      this.querySelectorAll('#headerExpandContent a').forEach((link) => {
        link.addEventListener('click', () => {
          this.classList.remove('expanded')
        })
      })
    }
  }

  // 注册 Web Component
  customElements.define('header-component', HeaderComponent)
</script>

<style>
  header-component {
    /* 容器过渡动效 */
    transition:
      padding 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.25s ease;

    /* 吸顶浮岛态：毛玻璃通透质感与微阴影 */
    &.not-top {
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-color: hsl(var(--border) / 0.85);
      background-color: hsl(var(--background) / 0.82);
      box-shadow:
        0 4px 20px -2px rgba(0, 0, 0, 0.05),
        0 2px 6px -1px rgba(0, 0, 0, 0.02);
    }

    /* 快速向下滚动时上滑隐藏，反向上滑时重新显现 */
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }

  /* 深色模式下的吸顶浮岛样式适配 */
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted) / 0.82);
    border-color: hsl(var(--border) / 0.85);
    box-shadow:
      0 6px 24px -2px rgba(0, 0, 0, 0.35),
      0 0 15px -3px rgba(84, 136, 156, 0.12);
  }

  /* 明暗模式图标切换状态机 */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      & .light {
        display: block;
      }
    }
  }
</style>
