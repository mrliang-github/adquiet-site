---
import { companySources, isRanking, locationText, safeExternalUrl, valuationText, type Catalog, type Company } from '../../lib/catalog'
interface Props { company: Company; data: Catalog }
const {company: c, data} = Astro.props
const ranking = isRanking(data)
const website = safeExternalUrl(c.profile?.website)
---
<article class='company-card' data-company-id={c.id}>
  <div class='company-topline'>
    <span>{ranking ? `榜单 #${c.rank}` : `名单序号 ${c.sequence}`}</span>
    {ranking && <span class='company-value'>{valuationText(c)}</span>}
  </div>
  <h3>{c.name}</h3>
  {c.nameEn && c.nameEn !== c.name && <p class='company-name-en'>{c.nameEn}</p>}
  <p class='company-location'>{locationText(c, data)}</p>
  <p class:list={['company-description', {'hub-muted': !c.profile?.description}]}>{c.profile?.description || '暂未收录业务资料，可先核对名单来源。'}</p>
  <details>
    <summary>查看来源与资料说明</summary>
    {c.profile?.description && <p>{c.profile.descriptionKind === 'excerpt' ? '公开资料摘录' : '业务资料整理'} · 核对日期 {c.profile.checkedAt}</p>}
    {!ranking && <p>{c.sourceType}。{c.verificationNote}</p>}
    {ranking && <p>估值基准 {data.metadata.valuationDate} · 人民币亿元。{c.founders ? `榜单负责人：${c.founders}。` : ''}不代表当前估值或任职信息。</p>}
    {c.profile && c.profile.products.length > 0 && <p>产品 / 关键词：{c.profile.products.join('、')}</p>}
    <div class='company-sources'>
      {companySources(c, data).map(s => <a href={s.url} target='_blank' rel='noopener noreferrer'>{s.label} ↗</a>)}
      {website && <a href={website} target='_blank' rel='noopener noreferrer'>收录网站 ↗</a>}
    </div>
    {website && <p>网站为收录线索，未逐一核验当前运营主体与可用性。</p>}
  </details>
</article>
