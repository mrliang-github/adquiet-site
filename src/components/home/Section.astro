---
import { cn } from 'astro-pure/utils'

// 定义 Section 组件的属性接口，支持标题与可选副标题描述
interface Props {
  class?: string
  title: string
  desc?: string
}

const { class: className, title, desc } = Astro.props
---

<section class={cn('flex flex-col gap-y-5 md:flex-row md:gap-y-0', className)}>
  <div class='md:min-w-40 flex flex-col gap-y-1'>
    <h2 class='text-xl font-medium text-foreground'>{title}</h2>
    {desc && <p class='text-xs text-muted-foreground leading-normal'>{desc}</p>}
  </div>
  <div class='flex flex-1 flex-col gap-y-3'>
    <slot />
  </div>
</section>
