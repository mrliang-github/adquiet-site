---
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import { getProjectCtaLabel, type ProjectItem } from '@/data/projects'

interface Props {
  class?: string
  projects: ProjectItem[]
}

const { class: className, projects, ...props } = Astro.props
---

<div class={cn('not-prose', className)} {...props}>
  <div class='grid grid-cols-1 gap-3.5 sm:grid-cols-2 sm:gap-4'>
    {
      projects.map((p) => {
        const showRepoLink = Boolean(p.github && p.github !== p.href)
        return (
          <article class='group hover-card-lift flex flex-col justify-between rounded-md border border-border/75 bg-background/85 p-4.5 transition-all hover:border-primary/45 hover:bg-muted/25'>
            <div>
              <div class='mb-2 flex flex-wrap items-center justify-between gap-1.5 text-xs text-muted-foreground'>
                <span class='rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-mono text-xs font-medium text-primary'>
                  {p.category}
                </span>
                <span class='rounded-md border border-border/60 bg-muted/80 px-2.5 py-0.5 text-xs font-normal text-muted-foreground'>
                  {p.status}
                </span>
              </div>

              <h3 class='mt-2 text-sm sm:text-base font-semibold text-foreground transition-colors group-hover:text-primary'>
                <a
                  href={p.href}
                  target={p.external ? '_blank' : undefined}
                  rel={p.external ? 'noopener noreferrer' : undefined}
                  class='no-underline text-inherit'
                >
                  {p.name}
                </a>
              </h3>

              <p class='mt-1.5 text-xs leading-relaxed text-muted-foreground'>
                {p.description}
              </p>
            </div>

            <div class='mt-3.5 flex items-center justify-between gap-2 border-t border-border/45 pt-2.5 text-xs'>
              <div>
                {showRepoLink && (
                  <a
                    href={p.github}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='inline-flex items-center gap-1 text-muted-foreground no-underline transition-colors hover:text-foreground'
                  >
                    <Icon class='size-3.5' name='github' />
                    <span>开源仓库 ↗</span>
                  </a>
                )}
              </div>
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener noreferrer' : undefined}
                class='font-medium text-primary no-underline hover:underline'
              >
                {getProjectCtaLabel(p)}
              </a>
            </div>
          </article>
        )
      })
    }
  </div>
</div>
