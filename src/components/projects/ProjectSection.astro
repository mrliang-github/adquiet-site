---
// 引入图标组件以展示 GitHub 开源仓库标识
import { Icon } from 'astro-pure/user'
// 引入样式类名合并工具
import { cn } from 'astro-pure/utils'
// 引入产品按钮文案生成函数与产品项类型定义
import { getProjectCtaLabel, type ProjectItem } from '@/data/projects'

// 定义产品列表区块组件的入参类型
interface Props {
  class?: string
  projects: ProjectItem[]
}

// 解构外部样式类、产品数组及透传属性
const { class: className, projects, ...props } = Astro.props
---

<div class={cn('not-prose', className)} {...props}>
  {/* 双列响应式产品卡片网格：移动端单列防挤压，平板及以上双列对齐 */}
  <div class='grid grid-cols-1 gap-3.5 sm:grid-cols-2 sm:gap-4'>
    {
      projects.map((p) => {
        // 仅当存在独立开源仓库且与主跳转地址不同时，才额外显示左下角仓库入口
        const showRepoLink = Boolean(p.github && p.github !== p.href)
        return (
          <article class='group hover-card-lift flex flex-col justify-between rounded-md border border-border/75 bg-background/85 p-4.5 transition-all hover:border-primary/45 hover:bg-muted/25'>
            <div>
              {/* 卡片头部：左侧圆角产品 Logo + 右侧产品名称与平台状态徽章 */}
              <div class='flex items-start gap-3.5'>
                {/* 紧邻产品标题展示的装饰性应用图标使用空 alt，避免读屏软件重复播报名称 */}
                <img
                  src={p.icon}
                  alt=''
                  width='44'
                  height='44'
                  loading='lazy'
                  class='size-11 shrink-0 rounded-xl border border-border/60 bg-muted/20 object-cover shadow-2xs'
                />

                <div class='min-w-0 flex-1'>
                  {/* 产品主名称链接 */}
                  <h3 class='text-sm font-semibold leading-snug text-foreground transition-colors group-hover:text-primary sm:text-base'>
                    <a
                      href={p.href}
                      target={p.external ? '_blank' : undefined}
                      rel={p.external ? 'noopener noreferrer' : undefined}
                      class='text-inherit no-underline'
                    >
                      {p.name}
                    </a>
                  </h3>

                  {/* 平台品类与分发渠道状态胶囊 */}
                  <div class='mt-1.5 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground'>
                    <span class='rounded-md border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-[11px] font-medium text-primary'>
                      {p.category}
                    </span>
                    <span class='rounded-md border border-border/60 bg-muted/80 px-2 py-0.5 text-[11px] font-normal text-muted-foreground'>
                      {p.status}
                    </span>
                  </div>
                </div>
              </div>

              {/* 产品核心功能简介 */}
              <p class='mt-3 text-xs leading-relaxed text-muted-foreground'>
                {p.description}
              </p>

              {/* 精准适用人群与高频痛点场景条 */}
              <p class='mt-2.5 rounded-sm border border-border/45 bg-muted/40 px-2.5 py-1.5 text-[11px] leading-snug text-muted-foreground'>
                <span class='font-medium text-foreground/85'>适合谁用：</span>
                <span>{p.audience}</span>
              </p>
            </div>

            {/* 卡片底栏：开源仓库链接与主操作按钮 */}
            <div class='mt-3.5 flex items-center justify-between gap-2 border-t border-border/45 pt-2.5 text-xs'>
              <div>
                {showRepoLink && (
                  <a
                    href={p.github}
                    target='_blank'
                    rel='noopener noreferrer'
                    class='inline-flex items-center gap-1 text-muted-foreground no-underline transition-colors hover:text-foreground'
                  >
                    <Icon class='size-3.5' name='github' />
                    <span>开源仓库 ↗</span>
                  </a>
                )}
              </div>
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener noreferrer' : undefined}
                class='font-medium text-primary no-underline hover:underline'
              >
                {getProjectCtaLabel(p)}
              </a>
            </div>
          </article>
        )
      })
    }
  </div>
</div>
