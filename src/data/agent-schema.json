{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liangxiaoai.dev/data/agents/schema.json",
  "title": "潜力公司库：完整快照或地区分块",
  "type": "object",
  "required": ["schemaVersion", "dataset", "version", "snapshotDate", "kind", "recordCount", "companies"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "dataset": {"enum": ["little-giants", "unicorns"]},
    "version": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshotDate": {"type": "string", "format": "date"},
    "kind": {"enum": ["snapshot", "region-part"]},
    "recordCount": {"type": "integer", "minimum": 0},
    "region": {"type": "string"},
    "part": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object", "required": ["title", "sourceName", "note", "snapshotDate", "count"], "properties": {
      "title": {"type": "string"}, "sourceName": {"type": "string"}, "sourceUrl": {"type": "string"},
      "note": {"type": "string"}, "qualificationNote": {"type": "string"}, "snapshotDate": {"type": "string", "format": "date"},
      "count": {"type": "integer"}, "currency": {"type": "string"}, "valuationUnit": {"type": "string"}, "valuationDate": {"type": "string"}
    }},
    "companies": {"type": "array", "items": {"$ref": "#/$defs/company"}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "snapshot"}}}, "then": {"required": ["metadata"]}},
    {"if": {"properties": {"kind": {"const": "region-part"}}}, "then": {"required": ["region", "part"], "properties": {"recordCount": {"maximum": 100}, "companies": {"maxItems": 100}}}}
  ],
  "$defs": {
    "source": {"type": "object", "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri"}}, "additionalProperties": false},
    "company": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "nameEn": {"type": "string"},
        "province": {"type": "string"}, "reportingRegion": {"type": "string"}, "sequence": {"type": "integer"},
        "sourceType": {"type": "string"}, "evidenceUrl": {"type": "string"}, "officialUrl": {"type": "string"}, "verificationNote": {"type": "string"},
        "country": {"type": "string"}, "city": {"type": "string"}, "industry": {"type": "string"}, "rank": {"type": "integer"}, "valuation": {"type": "number"}, "founders": {"type": "string"},
        "profile": {"type": "object", "additionalProperties": false, "properties": {
          "description": {"type": "string"}, "descriptionKind": {"type": "string"}, "products": {"type": "array", "items": {"type": "string"}},
          "website": {"type": "string"}, "websiteSource": {"type": "string"}, "websiteAvailability": {"type": "string"}, "checkedAt": {"type": "string", "format": "date"},
          "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
        }}
      }
    }
  }
}
