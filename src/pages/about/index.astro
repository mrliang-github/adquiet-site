---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
// 引入统一的微信公众号订阅卡片组件与公开配置
import WechatSubscribeCard from '@/components/wechat/WechatSubscribeCard.astro'
import { projects } from '@/data/projects'
import { wechatOfficialAccount } from '@/data/wechat'

export const prerender = true

const headings = [
  { depth: 2, slug: 'intro', text: '你好，我是良逍' },
  { depth: 2, slug: 'what-i-do', text: '做过的一些产品' },
  { depth: 2, slug: 'writing', text: '写作和学习' },
  { depth: 2, slug: 'stack', text: '平时用的工具' },
  { depth: 2, slug: 'contact', text: '联系我' }
]

// 直接复用数据层标记的精选代表作，避免在关于页维护重复的硬编码名称数组
const aboutProjects = projects.filter((p) => p.featured)
---

<PageLayout title='关于我' {headings} view>
  <h2 id='intro'>你好，我是良逍</h2>
  <p>
    我是良逍，学的是设计，做的是产品。主业是跨境电商相关的 CMS、ERP 等后台系统，平时的工作会涉及内容配置、商品管理和业务流程。
  </p>
  <p>
    工作之外，我用 AI 做一些 iOS、Apple Watch、macOS 和 Web 产品，也在尝试出海项目。以前主要做产品方案，现在也借助 AI 把想法做出来，再根据使用中遇到的问题继续修改。
  </p>
  <p>
    在其他平台上，我也用「良逍Ai出海」或「良逍Ai出海笔记」这个名字。这里放了我的一些产品、文章和学习记录。
  </p>

  <h2 id='what-i-do'>做过的一些产品</h2>
  <p>
    我做了一些录音转写、阅读听书、量房、处理文件和日常记录的工具，也有 Mac 应用与网页工具。下面是其中几款代表作：
  </p>

  <ProjectSection projects={aboutProjects} class='my-5' />

  <p>
    更多公开在架的应用、在线工具与开源项目可以在<a href='/projects'>产品与工具页</a>查看。
  </p>

  <h2 id='writing'>写作和学习</h2>
  <p>
    我会把做产品时用过的工具、遇到的问题和处理过程写下来。<a href='/blog'>文章与实战攻略</a>里主要是 AI 编程、产品设计和出海相关的内容，网站上也整理了供求职选公司参考的<a href='/data'>潜力公司库</a>、<a href='/daily'>风向标整理</a>和<a href='/english'>英语学习记录</a>。
  </p>
  <p>
    我也在生财有术看项目案例、参与交流，做过一些志愿者工作。看到感兴趣的方向，会尝试做点东西，再记录过程中的发现。
  </p>

  <h2 id='stack'>平时用的工具</h2>
  <p>
    做产品和开发会用到 Codex、Claude Code、VS Code，也会用飞书多维表和 Google Sheets 整理资料。写作、设计方面，用过 Typora、Photoshop 和 Illustrator。日常使用 Mac 和 Chrome。
  </p>

  <h2 id='contact'>联系我</h2>
  <p>
    如果你也在用 AI 做产品，或想持续看我的实战拆解、聊聊产品设计和合作，欢迎关注我的公众号或通过以下方式联系我。
  </p>

  {/* 在联系区域展示公众号卡片，方便读者直接扫码订阅 */}
  <WechatSubscribeCard class='my-5' />

  <ul>
    <li>
      <strong>微信公众号</strong>：<code>{wechatOfficialAccount.name}</code>（微信号：<code>{wechatOfficialAccount.accountId}</code>）
    </li>
    <li>
      <strong>微信联系</strong>：<code class='rounded-md border border-border/80 bg-muted/80 px-2.5 py-1 text-xs font-mono font-medium text-primary'>{wechatOfficialAccount.personalWechat}</code>（添加时请备注来源与来意）
    </li>
    <li>
      <strong>GitHub</strong>：<a href='https://github.com/mrliang-github' target='_blank' rel='noopener noreferrer'>@mrliang-github</a>（代码和开源项目）
    </li>
    <li>
      <strong>X (Twitter)</strong>：<a href='https://x.com/lingxio71220285' target='_blank' rel='noopener noreferrer'>@lingxio71220285</a>（日常更新）
    </li>
    <li>
      <strong>RSS 订阅</strong>：<a href='/rss.xml'>/rss.xml</a>（通过阅读器订阅文章更新）
    </li>
  </ul>
</PageLayout>
