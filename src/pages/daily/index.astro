---
import PageLayout from '@/layouts/BaseLayout.astro'
import { Button } from 'astro-pure/user'
import { getDailyReports, type DailyReportItem, type DailyDiscovery } from '@/data/content-helpers'

export const prerender = true

const reports = getDailyReports()

const meta = {
  title: '风向标日报',
  description: '海外出海机会、AI 产品动态、独立开发变现模式与高价值商业情报记录'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='flex flex-wrap items-center justify-between gap-4 mb-4 mt-6 sm:mt-10'>
        <div>
          <h1 class='text-3xl font-medium'>生财有术 · 风向标日报</h1>
          <p class='mt-2 text-muted-foreground text-sm'>
            海外出海机会、AI 变现模式与一线独立开发情报 · 共 {reports.length} 期
          </p>
        </div>
        <div class='flex items-center gap-2'>
          <a
            href='https://work.weixin.qq.com/ct/wcde8c6272cb42775a69efd3c537aa631fb4'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/20 transition-colors'
          >
            <span>领 3 天免费体验卡 ↗</span>
          </a>
          <a
            href='https://t.zsxq.com/FBJDh'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors'
          >
            <span>生财星球通道 ↗</span>
          </a>
        </div>
      </div>

      {/* 3 天免费体验卡领取福利横幅 */}
      <div class='my-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-emerald-500/25 bg-gradient-to-r from-emerald-500/10 via-background to-primary/5 p-4 sm:p-5 shadow-xs'>
        <div class='flex flex-col gap-1'>
          <div class='flex items-center gap-2'>
            <span class='rounded-full border border-emerald-500/30 bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400'>
              限时福利
            </span>
            <span class='text-xs font-semibold text-foreground'>生财有术 3 天免费体验卡</span>
          </div>
          <p class='text-xs text-muted-foreground mt-0.5 leading-relaxed'>
            “用好 AI 跟上时代，仅靠想法致富的时代来了”。我已经加入生财有术，邀你免费体验三天完整社群，畅读一线商业风向。
          </p>
        </div>
        <div class='flex items-center gap-3 shrink-0 self-end sm:self-auto'>
          <a
            href='https://work.weixin.qq.com/ct/wcde8c6272cb42775a69efd3c537aa631fb4'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center gap-1.5 rounded-full bg-emerald-600 px-3.5 py-1.5 text-xs font-medium text-white shadow-xs hover:bg-emerald-700 transition-colors'
          >
            <span>立即领卡 ↗</span>
          </a>
          <a
            href='/images/shengcai-trial-card.png'
            target='_blank'
            rel='noopener noreferrer'
            class='text-xs text-muted-foreground hover:text-foreground underline underline-offset-4'
          >
            查看海报
          </a>
        </div>
      </div>
    </div>

    <section aria-label='日报列表' class='animate mt-8'>
      <div class='flex flex-col gap-y-5'>
        {
          reports.map((report: DailyReportItem) => (
            <article class='group hover-card-lift relative flex flex-col gap-2 rounded-2xl border border-border/70 p-5 transition-all hover:bg-muted/30'>
              <div class='flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground'>
                <span class='font-mono font-medium text-primary'>
                  {report.editionDate}
                </span>
                {report.tags && report.tags.length > 0 && (
                  <div class='flex flex-wrap gap-2'>
                    {report.tags.map((tag: string) => (
                      <span class='rounded-md border border-border/60 bg-muted/70 px-2.5 py-1 text-xs text-muted-foreground'>{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <h2 class='text-lg font-medium tracking-tight text-foreground group-hover:text-primary transition-colors'>
                <a href={`/daily/${report.slug}/`} class='focus:outline-none'>
                  {report.title}
                </a>
              </h2>

              <p class='text-sm text-muted-foreground leading-relaxed line-clamp-2'>
                {report.summary}
              </p>

              {report.discoveries && report.discoveries.length > 0 && (
                <div class='mt-2 flex flex-col gap-1.5 border-t border-border/40 pt-3 text-xs'>
                  <span class='font-medium text-foreground/80'>核心看点：</span>
                  <ul class='list-disc list-inside space-y-1 text-muted-foreground'>
                    {report.discoveries.slice(0, 2).map((d: DailyDiscovery) => (
                      <li class='line-clamp-1'>
                        <span class='text-foreground/90'>{d.title}</span>
                        {(d.keyPoint || d.judgement) && ` — ${d.keyPoint || d.judgement}`}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class='mt-2 flex items-center justify-between pt-1 text-xs'>
                <a
                  href={`/daily/${report.slug}/`}
                  class='inline-flex items-center gap-1 font-medium text-primary hover:underline'
                >
                  阅读全文 →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</PageLayout>
