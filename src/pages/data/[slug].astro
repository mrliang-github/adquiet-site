---
import PageLayout from '@/layouts/BaseLayout.astro'
import CompanyCard from '@/components/catalog/CompanyCard.astro'
import { catalogs } from '@/data/catalog'
import { PAGE_SIZE, isRanking, optionsFor, type Catalog } from '../../lib/catalog'
import '../../styles/catalog.css'
export function getStaticPaths() {
  return catalogs.map(data => ({params: {slug: data.metadata.slug}, props: {data}}))
}
interface Props {data: Catalog}
const {data} = Astro.props
const m = data.metadata
const ranking = isRanking(data)
const title = ranking ? '胡润全球独角兽榜查询' : '专精特新“小巨人”企业查询'
const description = ranking ? '查询 2026 胡润全球独角兽榜快照中的 1,602 条企业记录。按国家、地区、行业和业务词筛选，查看历史估值，导出 CSV。' : '查询 2025 年第七批国家级专精特新小巨人公示名单中的 3,482 条企业记录。按省份、申报地区和业务词筛选，核对来源，导出 CSV。'
const dataUrl = `/data/${m.slug}.json?v=${m.sourceSha256.slice(0, 12)}`
const datasetSchema = {'@context':'https://schema.org', '@type':'Dataset', name:m.title, description: `${description} ${m.note} ${m.qualificationNote}`, url: new URL(`/data/${m.slug}/`, Astro.site).href, dateModified:m.snapshotDate, distribution:{'@type':'DataDownload', contentUrl:new URL(`/data/${m.slug}.json`, Astro.site).href, encodingFormat:'application/json'}, ...(m.sourceUrl ? {isBasedOn:m.sourceUrl} : {})}
---
<PageLayout meta={{title: `${title} · ${m.year} 年数据`, description}}>
  <main class='hub-shell' data-pagefind-body data-catalog-browser data-source={dataUrl}>
    <script type='application/ld+json' set:html={JSON.stringify(datasetSchema).replaceAll('<', '\\u003c')} />
    <nav class='hub-crumbs' aria-label='当前位置'><a href='/'>首页</a><span aria-hidden='true'>/</span><a href='/data/'>潜力公司库</a><span aria-hidden='true'>/</span><span>{ranking ? '独角兽榜单' : '小巨人名单'}</span></nav>
    <header>
      <p class='hub-kicker'>{m.year} 年 · {ranking ? '胡润研究院榜单快照' : '第七批公示名单 · 全国整理版'}</p>
      <h1 class='hub-title'>{title}</h1>
      <p class='hub-lead'>{ranking ? '按行业、国家或地区筛选公司，了解它在这份榜单中的位置与历史估值，再核对当前业务和招聘岗位。' : '按业务词和地区，找一批想进一步了解的公司，再核对当前业务和招聘岗位。'} 支持组合筛选和 CSV 导出。</p>
      <div class='hub-strip'><span><strong>{m.count.toLocaleString('zh-CN')}</strong> 条收录记录</span><span><strong>{m.profileCount.toLocaleString('zh-CN')}</strong> 条含业务资料</span><span>数据快照 <strong>{m.snapshotDate}</strong></span>{ranking && <span>估值单位 <strong>人民币亿元</strong></span>}</div>
    </header>
    <aside class='hub-notice'>
      {ranking ? <>估值基准日为 {m.valuationDate}，不代表实时估值。当前收录查询列表中的 1,602 条记录；发布稿的总数为 1,603 条，两者存在 1 条差异。</> : <>范围为 2025 年第七批新增公示名单，不含复核名单；公开来源整编，并非工信部全国正式附件原件。未逐家核验当前有效资格。</>}
      {' '}本页未接入实时招聘岗位，上榜不代表正在招聘。<a href='#data-method'>查看数据说明</a> · <a href='/guides/company-research/'>选公司指南</a>
    </aside>
    <form class='catalog-form' data-form role='search' aria-label='企业查询'>
      <fieldset disabled data-controls>
        <div class='catalog-search-row'>
          <label>企业名称或业务关键词<input type='search' name='q' maxlength='120' autocomplete='off' placeholder={ranking ? '例如：人工智能、OpenAI、新能源' : '例如：传感器、机器人、北京 导航'} /></label>
          <button class='hub-button primary' type='submit'>查询企业</button>
        </div>
        <div class='catalog-examples'><span>试试：</span>{(ranking ? ['人工智能', 'OpenAI', '新能源'] : ['传感器', '机器人', '北京 导航']).map(q => <button type='button' data-example={q}>{q}</button>)}</div>
        <div class='catalog-filters'>
          <label>{ranking ? '国家 / 地区' : '省份'}<select name='region'><option value=''>全部{ranking ? '国家 / 地区' : '省份'}</option>{optionsFor(data, 'region').map(o => <option value={o.value}>{o.value} · {o.count}</option>)}</select></label>
          <label>{ranking ? '行业' : '申报地区'}<select name='category'><option value=''>全部{ranking ? '行业' : '申报地区'}</option>{optionsFor(data, 'secondary').map(o => <option value={o.value}>{o.value} · {o.count}</option>)}</select></label>
          <label>排序<select name='sort'><option value='original'>{ranking ? '榜单顺序' : '名单顺序'}</option><option value='name'>企业名称</option>{ranking && <option value='valuation'>估值从高到低</option>}</select></label>
        </div>
        <div class='catalog-options'><label class='catalog-check'><input type='checkbox' name='business' />只看含业务资料的企业</label><button type='reset' class='hub-button'>清空条件</button></div>
      </fieldset>
    </form>
    <p class='catalog-status' data-status role='status' aria-live='polite'>正在准备查询数据；下方先展示名单前 {PAGE_SIZE} 条。</p>
    <button class='hub-button' type='button' data-retry hidden>重新加载数据</button>
    <noscript><p class='hub-notice'>当前浏览器未开启 JavaScript。下方可阅读前 {PAGE_SIZE} 条记录和来源；完整搜索、筛选与导出需要 JavaScript。</p></noscript>
    <section aria-label='企业查询结果'>
      <div class='catalog-toolbar' data-result-heading tabindex='-1'>
        <h2 data-count>收录 {m.count.toLocaleString('zh-CN')} 家企业</h2>
        <div class='catalog-actions'><button class='hub-button' type='button' data-share disabled>复制筛选链接</button><button class='hub-button' type='button' data-export disabled>导出筛选结果</button></div>
      </div>
      <div class='catalog-results' data-results data-pagefind-ignore>{data.companies.slice(0, PAGE_SIZE).map(c => <CompanyCard company={c} {data} />)}</div>
      <nav class='catalog-pagination' aria-label='结果翻页'><button class='hub-button' type='button' data-prev disabled>上一页</button><span data-page>第 1 / {Math.ceil(m.count / PAGE_SIZE)} 页</span><button class='hub-button' type='button' data-next disabled>下一页</button></nav>
    </section>
    <section id='data-method' class='hub-section hub-prose'>
      <h2>这份资料包括什么</h2>
      <p>{m.note} {m.qualificationNote}</p>
      {ranking ? <p>来源为<a href={m.sourceUrl} target='_blank' rel='noopener noreferrer'>胡润研究院榜单查询页</a>，发布于 {m.publishedDate}。<a href='https://www.hurun.net/en-us/info/detail?num=N5C7D1KGTE8G' target='_blank' rel='noopener noreferrer'>官方发布稿</a>与查询快照的总数有差异，本页保留实际收录数量。估值以人民币亿元展示，“榜单负责人”沿用来源字段，不等同于当前创始人或在任管理者。</p> : <p>名单按省份与申报地区分别整理。深圳等单列申报地区可单独筛选；企业卡片保留地区官方页面或转载来源，其中部分转载记录未逐条对照原附件复核。</p>}
      <p>业务介绍与网站属于补充资料，共有 {m.profileCount.toLocaleString('zh-CN')} 条业务介绍、{m.websiteCount.toLocaleString('zh-CN')} 条网站线索。摘录、整理内容及其来源会分别标注，未逐家人工核实；未收录资料不代表企业没有相关业务。</p>
      <p>关键词会匹配企业名称、地区、{ranking ? '行业、' : ''}已收录的业务介绍和产品词。多个关键词用空格分隔，结果需同时匹配；筛选网址可分享，导出包含当前全部筛选结果及来源说明。</p>
      <p><a href='/data/'>返回潜力公司库 →</a> · <a href='/guides/company-research/'>了解如何筛选求职公司 →</a></p>
    </section>
  </main>
</PageLayout>
<script>
  import '../../scripts/catalog-browser'
</script>
