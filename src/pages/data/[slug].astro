---
import PageLayout from '@/layouts/BaseLayout.astro'
import CompanyRow from '@/components/catalog/CompanyRow.astro'
import { catalogs } from '@/data/catalog'
import { PAGE_SIZE, isRanking, optionsFor, type Catalog } from '../../lib/catalog'
import '../../styles/catalog.css'
export function getStaticPaths() {
  return catalogs.map(data => ({params: {slug: data.metadata.slug}, props: {data}}))
}
interface Props {data: Catalog}
const {data} = Astro.props
const m = data.metadata
const ranking = isRanking(data)
const title = ranking ? '胡润全球独角兽榜查询' : '专精特新“小巨人”企业查询'
const description = ranking ? '查询 2026 胡润全球独角兽榜 1,602 家核心企业估值与主营业务。支持按国家、地区、行业赛道及业务关键词检索穿透，支持全量导出。' : '查询 2025 年第七批国家级专精特新小巨人 3,482 家企业名录。支持按省份、申报地区和业务领域检索，溯源官方公示依据，支持全量导出。'
const dataUrl = `/data/${m.slug}.json?v=${m.sourceSha256.slice(0, 12)}`
const datasetSchema = {'@context':'https://schema.org', '@type':'Dataset', name:m.title, description: `${description} ${m.note} ${m.qualificationNote}`, url: new URL(`/data/${m.slug}/`, Astro.site).href, dateModified:m.snapshotDate, distribution:{'@type':'DataDownload', contentUrl:new URL(`/data/${m.slug}.json`, Astro.site).href, encodingFormat:'application/json'}, ...(m.sourceUrl ? {isBasedOn:m.sourceUrl} : {})}
---
<PageLayout meta={{title: `${title} · ${m.year} 年数据`, description}}>
  <main class='hub-shell' data-pagefind-body data-catalog-browser data-source={dataUrl}>
    <script type='application/ld+json' set:html={JSON.stringify(datasetSchema).replaceAll('<', '\\u003c')} />
    <nav class='hub-crumbs' aria-label='当前位置'><a href='/'>首页</a><span aria-hidden='true'>/</span><a href='/data/'>潜力公司库</a><span aria-hidden='true'>/</span><span>{ranking ? '独角兽榜单' : '小巨人名单'}</span></nav>
    <header>
      <p class='hub-kicker'>{m.year} 年 · {ranking ? '胡润全球独角兽企业快照' : '第七批专精特新小巨人公示名录'}</p>
      <h1 class='hub-title'>{title}</h1>
      <p class='hub-lead'>{ranking ? '聚合全球估值 10 亿美元以上的独角兽企业画像与估值基准，支持按行业赛道、地域及主营业务关键词深度穿透分析。' : '聚合国家级专精特新小巨人公示企业画像与申报归属，支持按省市、业务领域精准检索与公开依据溯源。'} 支持多维组合筛选与 CSV 数据导出。</p>
      <div class='hub-strip'><span><strong>{m.count.toLocaleString('zh-CN')}</strong> 家收录企业</span><span><strong>{m.profileCount.toLocaleString('zh-CN')}</strong> 家含业务简介</span><span>数据快照 <strong>{m.snapshotDate}</strong></span>{ranking && <span>估值基准单位 <strong>人民币亿元</strong></span>}</div>
    </header>
    <aside class='hub-notice'>
      {ranking ? <>估值基准日为 {m.valuationDate}，反映榜单发布时点估值。当前收录 1,602 条企业记录，数据整理自胡润研究院官方公开榜单快照。</> : <>范围为 2025 年第七批新增专精特新“小巨人”公示名单，整理自各省市工信部门公开文件，最终认定资质以官方核发为准。</>}
      {' '}<a href='#data-method'>查看数据口径与来源说明</a> · <a href='/guides/company-research/'>企业调研分析指南</a>
    </aside>
    <form class='catalog-form' data-form role='search' aria-label='企业查询'>
      <fieldset disabled data-controls>
        <div class='catalog-search-row'>
          <label>企业名称或业务关键词<input type='search' name='q' maxlength='120' autocomplete='off' placeholder={ranking ? '输入企业名称、主营业务或产品关键词（如：人工智能、OpenAI、新能源）' : '输入企业名称、核心技术或产品领域（如：传感器、机器人、北京 导航）'} /></label>
          <button class='hub-button primary' type='submit'>查询企业</button>
        </div>
        <div class='catalog-examples'><span>试试：</span>{(ranking ? ['人工智能', 'OpenAI', '新能源'] : ['传感器', '机器人', '北京 导航']).map(q => <button type='button' data-example={q}>{q}</button>)}</div>
        <div class='catalog-filters'>
          <label>{ranking ? '国家 / 地区' : '省份'}<select name='region'><option value=''>全部{ranking ? '国家 / 地区' : '省份'}</option>{optionsFor(data, 'region').map(o => <option value={o.value}>{o.value} · {o.count}</option>)}</select></label>
          <label>{ranking ? '行业赛道' : '申报地区'}<select name='category'><option value=''>全部{ranking ? '行业赛道' : '申报地区'}</option>{optionsFor(data, 'secondary').map(o => <option value={o.value}>{o.value} · {o.count}</option>)}</select></label>
          <label>排序<select name='sort'><option value='original'>{ranking ? '榜单顺序' : '名单顺序'}</option><option value='name'>企业名称</option>{ranking && <option value='valuation'>估值从高到低</option>}</select></label>
        </div>
        <div class='catalog-options'><label class='catalog-check'><input type='checkbox' name='business' />仅看已收录业务简介的企业</label><button type='reset' class='hub-button'>清空条件</button></div>
      </fieldset>
    </form>
    <p class='catalog-status' data-status role='status' aria-live='polite'>正在准备查询数据；下方先展示名单前 {PAGE_SIZE} 条。</p>
    <button class='hub-button' type='button' data-retry hidden>重新加载数据</button>
    <noscript><p class='hub-notice'>当前浏览器未开启 JavaScript。下方可阅读前 {PAGE_SIZE} 条记录和来源；完整搜索、筛选与导出需要 JavaScript。</p></noscript>
    <section aria-label='企业查询结果'>
      <div class='catalog-toolbar' data-result-heading tabindex='-1'>
        <h2 data-count>收录 {m.count.toLocaleString('zh-CN')} 家企业</h2>
        <div class='catalog-actions'><button class='hub-button' type='button' data-share disabled>复制筛选链接</button><button class='hub-button' type='button' data-export disabled>导出筛选结果</button></div>
      </div>
      <p class='catalog-table-hint' id='catalog-table-hint'>按行浏览企业，点击“查看档案 ↗”可呼出完整主营业务画像、产品标签与公开核验依据。<span>左右滑动查看其他列，企业名称会固定在左侧。</span></p>
      <div class='catalog-table-scroll' role='region' aria-label='企业数据表' aria-describedby='catalog-table-hint' tabindex='0' data-pagefind-ignore>
        <table class:list={['catalog-table', {'catalog-table-ranking': ranking}]}>
          <caption class='sr-only'>{title}，数据快照 {m.snapshotDate}</caption>
          <colgroup><col class='catalog-col-name' /><col class='catalog-col-order' /><col class='catalog-col-region' /><col />{ranking && <col class='catalog-col-value' />}<col class='catalog-col-website' /></colgroup>
          <thead><tr>
            <th scope='col'>企业名称</th><th scope='col'>{ranking ? '全球名次' : '名单序号'}</th><th scope='col'>{ranking ? '国家 / 地区' : '地区'}</th><th scope='col'>{ranking ? '行业 / 主营业务' : '主营业务简介'}</th>
            {ranking && <th scope='col' class='company-value-heading'>榜单估值<span>人民币亿元</span></th>}
            <th scope='col'>官方网站</th>
          </tr></thead>
          <tbody data-results>{data.companies.slice(0, PAGE_SIZE).map(c => <CompanyRow company={c} {data} />)}</tbody>
        </table>
      </div>
      <nav class='catalog-pagination' aria-label='结果翻页'><button class='hub-button' type='button' data-prev disabled>上一页</button><span data-page>第 1 / {Math.ceil(m.count / PAGE_SIZE)} 页</span><button class='hub-button' type='button' data-next disabled>下一页</button></nav>
    </section>
    <section id='data-method' class='hub-section hub-prose'>
      <h2>这份资料包括什么</h2>
      <p>{m.note} {m.qualificationNote}</p>
      {ranking ? <p>来源为<a href={m.sourceUrl} target='_blank' rel='noopener noreferrer'>胡润研究院榜单查询页</a>，发布于 {m.publishedDate}。<a href='https://www.hurun.net/en-us/info/detail?num=N5C7D1KGTE8G' target='_blank' rel='noopener noreferrer'>官方发布稿</a>与查询快照的总数有差异，本页保留实际收录数量。估值以人民币亿元展示，“榜单负责人”沿用来源字段，不等同于当前创始人或在任管理者。</p> : <p>名单按省份与申报地区分别整理。深圳等单列申报地区可单独筛选；每条记录保留地区官方页面或转载来源，其中部分转载记录未逐条对照原附件复核。</p>}
      <p>企业主营业务画像与官网直达为补充收录资料，当前已覆盖 {m.profileCount.toLocaleString('zh-CN')} 家企业业务简介及 {m.websiteCount.toLocaleString('zh-CN')} 条官方网站。信息来源已逐条注明出处与核验时点；未收录不代表企业没有相关业务。</p>
      <p>关键词检索支持匹配企业名称、地区、{ranking ? '行业赛道、' : ''}主营业务与产品领域。多个关键词用空格分隔即可交集查询；支持 URL 状态分享与全量 CSV 数据导出。</p>
      <p><a href='/data/'>返回潜力公司库 →</a> · <a href='/guides/company-research/'>查阅企业深度调研指南 →</a></p>
    </section>

    <!-- 企业档案详情抽屉弹窗（吸收 unicorn-atlas 视觉规范与信息架构） -->
    <dialog id='company-detail-dialog' class='company-detail-dialog' aria-labelledby='company-dialog-title'>
      <div class='company-dialog-shell' data-dialog-content>
        <!-- 弹窗内容由客户端交互脚本动态渲染 -->
      </div>
    </dialog>
  </main>
</PageLayout>
<script>
  import '../../scripts/catalog-browser'
</script>
