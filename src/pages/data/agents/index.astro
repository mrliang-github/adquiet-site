<script>
  function setupAgentAccessPage() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-mode-tab]')
    const panels = document.querySelectorAll<HTMLElement>('[data-mode-panel]')
    if (!tabs.length) return

    const validModes = new Set(['skill', 'prompt', 'api'])
    const activate = (mode: string, syncUrl = false) => {
      const target = validModes.has(mode) ? mode : 'skill'
      tabs.forEach((tab) => {
        const isCurrent = tab.dataset.modeTab === target
        tab.classList.toggle('active', isCurrent)
        tab.setAttribute('aria-selected', String(isCurrent))
      })
      panels.forEach((panel) => {
        const isCurrent = panel.dataset.modePanel === target
        panel.classList.toggle('active', isCurrent)
        panel.hidden = !isCurrent
      })
      if (syncUrl) {
        const url = new URL(window.location.href)
        if (target === 'skill') url.searchParams.delete('tab')
        else url.searchParams.set('tab', target)
        window.history.replaceState({}, '', url)
      }
    }

    const initialTab = new URLSearchParams(window.location.search).get('tab') || 'skill'
    activate(initialTab, false)

    tabs.forEach((tab) => {
      if (tab.dataset.bound === 'true') return
      tab.dataset.bound = 'true'
      tab.addEventListener('click', () => activate(tab.dataset.modeTab || 'skill', true))
    })

    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-text]')
    copyButtons.forEach((btn) => {
      if (btn.dataset.bound === 'true') return
      btn.dataset.bound = 'true'
      btn.addEventListener('click', () => {
        const text = btn.dataset.copyText || ''
        if (!text) return
        void navigator.clipboard.writeText(text).then(() => {
          const original = btn.textContent
          btn.textContent = '已复制'
          btn.disabled = true
          setTimeout(() => {
            btn.textContent = original
            btn.disabled = false
          }, 1600)
        })
      })
    })
  }

  setupAgentAccessPage()
  document.addEventListener('astro:page-load', setupAgentAccessPage)
</script>
