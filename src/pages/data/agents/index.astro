---
// 导入全站基础页面布局组件
import PageLayout from '@/layouts/BaseLayout.astro'
// 导入静态构建期生成的 Agent 数据资产包
import { agentBundle } from '@/data/agent-access'
// 导入数据集全局通用样式
import '../../../styles/catalog.css'

// 声明页面为静态预渲染
export const prerender = true
// 从资产包中提取已注册的数据集列表
const { datasets } = agentBundle

// 标准化 Agent 接入指令模板（专业、中立、面向商业与分析场景）
const prompt = '请先读取 https://liangxiaoai.dev/data/agents/manifest.json，按指定数据集与目标地域获取对应分块，在本地按业务赛道与关键词执行过滤分析。提取企业名称、主营业务画像、官网链接、估值/公示序号及原始核验来源，并标注快照更新日期。'
---
<PageLayout
  meta={{
    title: 'Agent 数据接口 · 机器可读数据网关 | 潜力公司库',
    description: '面向 AI Agent 与自动化分析工作流的开放数据端点。提供标准 Manifest 清单、地域分片索引与全量 JSON 快照，支持免登录机器解析。'
  }}
>
  <main class='hub-shell' data-pagefind-body>
    <!-- 面包屑导航 -->
    <nav class='hub-crumbs' aria-label='当前位置'>
      <a href='/'>首页</a>
      <span aria-hidden='true'>/</span>
      <a href='/data/'>潜力公司库</a>
      <span aria-hidden='true'>/</span>
      <span>Agent 数据接口</span>
    </nav>

    <!-- 顶部标题与定位介绍 -->
    <header>
      <p class='hub-kicker'>面向 LLM & 自动化工作流的开放数据协议</p>
      <h1 class='hub-title'>Agent 开放数据网关</h1>
      <p class='hub-lead'>专为 AI Agent、数据分析脚本及大模型工作流设计的无状态只读数据接口。提供标准 Schema、地域分片索引与全量快照，支持免登录机器读取与本地穿透分析。</p>
    </header>

    <!-- 规范入口快捷链接 -->
    <div class='agent-entry-links'>
      <a class='hub-button primary' href='/data/agents/manifest.json' data-astro-prefetch='false'>读取 Manifest 清单 →</a>
      <a class='hub-button' href='/data/agents/README.md' data-astro-prefetch='false'>接入与调用规范 (README)</a>
      <a class='hub-button' href='/data/agents/schema.json' data-astro-prefetch='false'>JSON Schema 规范</a>
    </div>

    <!-- Agent 提示词接入指令模板模块 -->
    <section class='hub-section' aria-labelledby='agent-prompt-title'>
      <h2 id='agent-prompt-title'>Agent 接入指令模板 (Prompt Template)</h2>
      <blockquote class='agent-prompt'>{prompt}</blockquote>
      <p class='hub-muted'>支持在此指令后按需指定目标地域、所属赛道或技术关键词（例如：“目标地域：广东省，核心赛道：人形机器人与具身智能”），Agent 将在本地环境完成解析与穿透分析。</p>
    </section>

    <!-- 可用数据集与端点分布清单 -->
    <section class='hub-section' aria-labelledby='agent-datasets-title'>
      <h2 id='agent-datasets-title'>收录数据集与端点分布</h2>
      <div class='agent-datasets'>
        {datasets.map(dataset => (
          <article class='agent-dataset'>
            <h3>{dataset.title}</h3>
            <p>{dataset.recordCount.toLocaleString('zh-CN')} 家企业画像 · 快照日期 <time datetime={dataset.snapshotDate}>{dataset.snapshotDate}</time></p>
            <p class='hub-muted'>{dataset.profileCount.toLocaleString('zh-CN')} 家含主营业务简介 · {dataset.websiteCount.toLocaleString('zh-CN')} 家含官方网站</p>
            <div class='agent-entry-links'>
              <a class='hub-link' href={new URL(dataset.index.url).pathname} data-astro-prefetch='false'>地域分片索引 →</a>
              <a class='hub-link' href={new URL(dataset.snapshot.url).pathname} data-astro-prefetch='false'>全量快照 JSON · {(dataset.snapshot.bytes / 1_000_000).toFixed(2)} MB →</a>
            </div>
            <a class='hub-link' href={new URL(dataset.pageUrl).pathname}>在线网页查询 →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- 数据读取策略与客户端缓存规范（规范化技术说明） -->
    <section class='hub-section hub-prose' aria-labelledby='agent-reading-title'>
      <h2 id='agent-reading-title'>数据读取策略与客户端缓存规范</h2>
      <ol>
        <li><strong>分片按需检索</strong>：优先解析 Manifest 清单并定位对应地域的分片索引（每个分块上限 100 家企业），避免无效的全量网络拉取。</li>
        <li><strong>本地计算优先</strong>：建议通过客户端脚本在本地完成初筛与多维统计，再将提炼后的结果交由大模型做语义分析，大幅降低 Token 消耗与网络往返。</li>
        <li><strong>并发与频控建议</strong>：Manifest 清单建议客户端缓存 1 小时，单客户端并发下载建议 ≤ 2；所有版本化资源支持通过 SHA-256 哈希比对增量变更。</li>
      </ol>
      <p>完整字段定义、缓存策略与错误处理约定详见<a href='/data/agents/README.md' data-astro-prefetch='false'>接入说明文档</a>。引用分析结论时请注明快照日期与原始核验出处。</p>
    </section>

    <!-- 客观性声明与免责背书 -->
    <aside class='hub-notice hub-section'>
      数据声明与免责：本数据接口仅供商业研究、企业调研与学术分析使用。名录记录与估值反映发布时点客观快照，不代表企业实时运营状态；资质以主管部门最终核准为准，第三方数据版权归原发布方所有。
    </aside>
  </main>
</PageLayout>

<style>
  /* 链接按钮排列 */
  .agent-entry-links { display: flex; flex-wrap: wrap; align-items: center; gap: .85rem; margin: 1.25rem 0; }
  /* 指令模板代码块风格微圆角 */
  .agent-prompt { margin: 1.25rem 0; padding: 1.25rem; border-left: 3px solid hsl(var(--primary)); border-radius: 6px; background: hsl(var(--muted)); line-height: 1.9; overflow-wrap: anywhere; }
  /* 数据集卡片网格 */
  .agent-datasets { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  /* 单个数据集卡片（符合全站 6px 严肃微圆角规范） */
  .agent-dataset { border: 1px solid hsl(var(--border)); border-radius: 6px; padding: 1.25rem; background: hsl(var(--background)); }
  .agent-dataset h3 { font-weight: 600; font-size: 1.1rem; }
  .agent-dataset p { margin-top: .75rem; line-height: 1.7; }
  @media (max-width: 639px) { .agent-datasets { grid-template-columns: 1fr; } }
</style>
