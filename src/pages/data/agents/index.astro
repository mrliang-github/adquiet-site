---
import PageLayout from '@/layouts/BaseLayout.astro'
import { agentBundle } from '@/data/agent-access'
import '../../../styles/catalog.css'

export const prerender = true

const { datasets } = agentBundle
const totalRecords = datasets.reduce((sum, item) => sum + item.recordCount, 0)
const giants = datasets.find((item) => item.id === 'little-giants')!
const unicorns = datasets.find((item) => item.id === 'unicorns')!

const skillInstallPrompt = `请安装潜力公司库 Skill：https://liangxiaoai.dev/data/agents/skill/README.md
装完在你平时执行命令的环境里请求一次 https://liangxiaoai.dev/data/agents/manifest.json ；连不上的话，告诉我要怎么给你开联网。
装完告诉我是否需要开启新会话。`

const skillVerifyQuestion = '深圳有哪些做机器人或传感器的专精特新小巨人公司？'

const skillQuestions = [
  '广东省有哪些做机器视觉或工业传感器的专精特新小巨人公司？',
  '北京有哪些做人工智能的独角兽公司？按估值排个序。',
  '上海有哪些做医疗器械或生物医药的小巨人企业？附上官网。',
  '杭州有哪些上榜胡润独角兽的公司？它们主要做什么业务？',
  '从江苏的小巨人名单里找 10 家半导体相关公司，整理成求职候选表。'
]

const skillCliInstall = `# 通用 Agent Skills（Codex、Gemini CLI、GitHub Copilot、OpenCode 共用）
mkdir -p ~/.agents/skills/potential-companies
curl --compressed -fsSL https://liangxiaoai.dev/data/agents/skill/SKILL.md -o ~/.agents/skills/potential-companies/SKILL.md

# Claude Code（建一条指向同一目录的软链，不复制第二份）
mkdir -p ~/.claude/skills && ln -sfn ~/.agents/skills/potential-companies ~/.claude/skills/potential-companies`

const directPrompt = `请先阅读 https://liangxiaoai.dev/data/agents/README.md ，按里面的说明帮我查询：深圳有哪些做机器人或传感器的专精特新小巨人公司？`

const directExamples = [
  {
    label: '查深圳机器人与传感器小巨人',
    text: '请先阅读 https://liangxiaoai.dev/data/agents/README.md ，按里面的说明帮我查询：深圳有哪些做机器人或传感器的专精特新小巨人公司？'
  },
  {
    label: '查北京人工智能独角兽并按估值排序',
    text: '请先阅读 https://liangxiaoai.dev/data/agents/README.md ，按里面的说明帮我查询：北京有哪些做人工智能的独角兽公司？按估值排个序并附上业务简介。'
  },
  {
    label: '查江浙沪半导体小巨人整理求职表',
    text: '请先阅读 https://liangxiaoai.dev/data/agents/README.md ，按里面的说明从江苏、浙江、上海的小巨人名单里找 10 家半导体相关公司，列出名称、城市、主营业务和官网。'
  }
]

const firstApiRequest = `curl --compressed -fsSL 'https://liangxiaoai.dev/data/agents/manifest.json'`
---

<PageLayout
  meta={{
    title: 'Agent 接入 · 潜力公司库',
    description:
      '把潜力公司库接进你的 Agent：支持 Agent Skill 一键安装、免安装单句提问与匿名只读 JSON 接口，无需注册或 API Key。'
  }}
  highlightColor='#54889C'
>
  <main class='hub-shell' id='main' data-pagefind-body>
    <nav class='hub-crumbs' aria-label='当前位置'>
      <a href='/'>首页</a>
      <span aria-hidden='true'>/</span>
      <a href='/data/'>潜力公司库</a>
      <span aria-hidden='true'>/</span>
      <span>Agent 接入</span>
    </nav>

    <header class='agent-hero'>
      <p class='hub-kicker'>AGENT 接入</p>
      <h1 class='hub-title'>把潜力公司库接进你的 Agent</h1>
      <p class='hub-lead'>
        Agent Skill、免安装直接问、JSON 接口三种方式读的是同一份公开数据：专精特新“小巨人”公示名单（{giants.recordCount.toLocaleString('zh-CN')} 家）和胡润全球独角兽榜（{unicorns.recordCount.toLocaleString('zh-CN')} 家），按你用的工具选一种就行。全部匿名只读，不用注册，也不用 API Key。
      </p>

      <div class='agent-status-row' aria-label='服务状态'>
        <span class='status-chip ok'>
          <span class='status-dot' aria-hidden='true'></span>
          服务正常
        </span>
        <span class='status-chip'>版本 1.0</span>
        <span class='status-chip'>{totalRecords.toLocaleString('zh-CN')} 家企业</span>
        <span class='status-chip'>匿名只读 · 无需 Key</span>
      </div>
    </header>

    <!-- 方式选择卡片 -->
    <div class='mode-grid' role='tablist' aria-label='选择接入方式'>
      <button
        type='button'
        role='tab'
        id='tab-skill'
        aria-selected='true'
        aria-controls='panel-skill'
        data-mode-tab='skill'
        class='mode-card active'
      >
        <div class='mode-card-top'>
          <span class='mode-title'>Agent Skill</span>
          <span class='mode-recommend'>最省事</span>
        </div>
        <p class='mode-desc'>装一次，以后不用再更新</p>
        <p class='mode-tools'>Claude Code、Codex、Gemini CLI、OpenCode</p>
      </button>

      <button
        type='button'
        role='tab'
        id='tab-prompt'
        aria-selected='false'
        aria-controls='panel-prompt'
        data-mode-tab='prompt'
        class='mode-card'
      >
        <div class='mode-card-top'>
          <span class='mode-title'>免安装直接问</span>
        </div>
        <p class='mode-desc'>复制一句话，临时查一次</p>
        <p class='mode-tools'>ChatGPT、Claude 网页版、DeepSeek 等联网助手</p>
      </button>

      <button
        type='button'
        role='tab'
        id='tab-api'
        aria-selected='false'
        aria-controls='panel-api'
        data-mode-tab='api'
        class='mode-card'
      >
        <div class='mode-card-top'>
          <span class='mode-title'>JSON 接口</span>
        </div>
        <p class='mode-desc'>匿名 GET，自己写程序取数</p>
        <p class='mode-tools'>Python 脚本、表格同步、行研看板</p>
      </button>
    </div>

    <!-- 方式 1：Agent Skill -->
    <section
      id='panel-skill'
      role='tabpanel'
      aria-labelledby='tab-skill'
      data-mode-panel='skill'
      class='mode-panel active'
    >
      <div class='panel-head'>
        <span class='panel-tag'>Agent Skill · 1.0</span>
        <h2>装一次，以后不用再更新</h2>
        <p>
          不用记接口，也不用写代码。Claude Code、Codex、Gemini CLI、OpenCode 这类支持 Agent Skills 的工具都能装，把下面这段话发给它就行。装好后直接用大白话问它某个城市、某个赛道有哪些公司；以后公司库补充新批次，装好的 Skill 会自动用上。
        </p>
      </div>

      <ol class='step-list'>
        <li class='step-item'>
          <span class='step-badge' aria-hidden='true'>1</span>
          <div class='step-body'>
            <h3>复制这段话，发给你的 Agent</h3>
            <p class='step-hint'>它会自己装好单个 <code>SKILL.md</code> 文件，不会改动你装过的其他 Skill。</p>
            <div class='copy-box'>
              <div class='copy-box-bar'>
                <span>安装提示词</span>
                <button type='button' class='copy-btn' data-copy-text={skillInstallPrompt}>复制</button>
              </div>
              <pre>{skillInstallPrompt}</pre>
            </div>
          </div>
        </li>

        <li class='step-item'>
          <span class='step-badge' aria-hidden='true'>2</span>
          <div class='step-body'>
            <h3>开一个新会话</h3>
            <p class='step-hint'>多数 Agent 只在会话开始时读取 Skill，当前对话里不一定看得到。</p>
          </div>
        </li>

        <li class='step-item'>
          <span class='step-badge' aria-hidden='true'>3</span>
          <div class='step-body'>
            <h3>问一句试试</h3>
            <div class='inline-copy-row'>
              <span>{skillVerifyQuestion}</span>
              <button type='button' class='copy-btn' data-copy-text={skillVerifyQuestion}>复制</button>
            </div>
            <p class='step-hint mt-2'>回答注明了快照日期、给出匹配企业与业务摘要、附上公开来源链接，就是装好了。</p>
          </div>
        </li>
      </ol>

      <div class='sub-block'>
        <h3>装好后可以这样问</h3>
        <ul class='question-list'>
          {skillQuestions.map((q) => (
            <li>
              <span>{q}</span>
              <button type='button' class='copy-btn' data-copy-text={q}>复制</button>
            </li>
          ))}
        </ul>
      </div>

      <div class='fold-group'>
        <details class='fold-card'>
          <summary>用命令行手动安装</summary>
          <div class='fold-body'>
            <div class='copy-box'>
              <div class='copy-box-bar'>
                <span>bash</span>
                <button type='button' class='copy-btn' data-copy-text={skillCliInstall}>复制</button>
              </div>
              <pre>{skillCliInstall}</pre>
            </div>
            <p class='step-hint mt-2.5'>
              通用目录是 <code>~/.agents/skills/potential-companies</code>，装一次就能被多个 Agent 发现；执行前可先审阅纯文本文件 <a href='/data/agents/skill/SKILL.md' target='_blank' rel='noopener noreferrer'>SKILL.md</a> 与 <a href='/data/agents/skill/README.md' target='_blank' rel='noopener noreferrer'>安装说明</a>。
            </p>
          </div>
        </details>

        <details class='fold-card'>
          <summary>没触发或连不上？按这个顺序查</summary>
          <div class='fold-body'>
            <ol class='trouble-list'>
              <li>确认文件名严格为 <code>SKILL.md</code>，且位于当前 Agent 支持的 skills 目录下。</li>
              <li>关掉旧会话，新开一个会话再问上面的验证问题。</li>
              <li>让 Agent 列出它发现的 skills，确认里面有 <code>potential-companies</code>。</li>
              <li>若提示连不上 <code>liangxiaoai.dev</code>（如 <code>Could not resolve host</code>）：说明执行命令的沙箱未开联网。例如 Codex 可在 <code>~/.codex/config.toml</code> 的 <code>[sandbox_workspace_write]</code> 下开启 <code>network_access = true</code> 后重开会话。</li>
            </ol>
          </div>
        </details>
      </div>
    </section>

    <!-- 方式 2：免安装直接问 -->
    <section
      id='panel-prompt'
      role='tabpanel'
      aria-labelledby='tab-prompt'
      data-mode-panel='prompt'
      class='mode-panel'
      hidden
    >
      <div class='panel-head'>
        <span class='panel-tag'>免安装 · 单句提问</span>
        <h2>不装 Skill，发一句话就能查</h2>
        <p>
          在网页版对话窗口临时查一次，或者不想安装本地文件时，直接让能联网的 Agent 读 <a href='/data/agents/README.md' target='_blank' rel='noopener noreferrer'>/data/agents/README.md</a> 就行；Skill 读的也是这份说明，Agent 会自己按省份拉取小体积分片，不会把几千条数据全塞进上下文。
        </p>
      </div>

      <div class='copy-box'>
        <div class='copy-box-bar'>
          <span>复制发给 Agent（把冒号后的问题换成你的即可）</span>
          <button type='button' class='copy-btn' data-copy-text={directPrompt}>复制</button>
        </div>
        <pre>{directPrompt}</pre>
      </div>

      <div class='sub-block'>
        <h3>改好的现成提问，点一下直接用</h3>
        <ul class='question-list'>
          {directExamples.map((item) => (
            <li>
              <div>
                <strong class='block text-xs text-foreground mb-0.5'>{item.label}</strong>
                <span class='text-xs text-muted-foreground'>{item.text}</span>
              </div>
              <button type='button' class='copy-btn shrink-0' data-copy-text={item.text}>复制</button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 方式 3：JSON 接口 -->
    <section
      id='panel-api'
      role='tabpanel'
      aria-labelledby='tab-api'
      data-mode-panel='api'
      class='mode-panel'
      hidden
    >
      <div class='panel-head'>
        <span class='panel-tag'>JSON 接口 · 1.0</span>
        <h2>匿名 GET，拿来就能用</h2>
        <p>
          不用 token；浏览器跨域、<code>curl</code> 和各语言默认的 HTTP 客户端都能直接调。先读根清单 <code>/data/agents/manifest.json</code> 拿当前版本的索引地址，字段定义以 <a href='/data/agents/schema.json' target='_blank' rel='noopener noreferrer'>JSON Schema</a> 为准。
        </p>
      </div>

      <div class='copy-box'>
        <div class='copy-box-bar'>
          <span>第一个请求</span>
          <button type='button' class='copy-btn' data-copy-text={firstApiRequest}>复制</button>
        </div>
        <pre>{firstApiRequest}</pre>
      </div>

      <div class='sub-block'>
        <h3>用得省，也更快</h3>
        <div class='tips-grid'>
          <div class='tip-card'>
            <span class='tip-num'>01</span>
            <h4>开压缩</h4>
            <p><code>curl</code> 加 <code>--compressed</code>，其他客户端开启 gzip 或 br，JSON 传输体积只有原来的 1/5 左右。</p>
          </div>
          <div class='tip-card'>
            <span class='tip-num'>02</span>
            <h4>按地区取分片</h4>
            <p>从清单读取 <code>index.url</code>，只拉目标省份或国家的 <code>parts[].url</code>（每片 ≤ 100 家，约 25–45 KB）。</p>
          </div>
          <div class='tip-card'>
            <span class='tip-num'>03</span>
            <h4>本地缓存复用</h4>
            <p>分片与快照路径自带 SHA-256 版本号，下载一次即可长期缓存；清单最多每小时检查一次，并发 ≤ 2。</p>
          </div>
        </div>
      </div>

      <div class='sub-block'>
        <h3>接口一览</h3>
        <div class='api-table-wrap'>
          <table class='api-table'>
            <thead>
              <tr>
                <th>路径</th>
                <th>用来做什么</th>
                <th>多久取一次</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>/data/agents/manifest.json</code></td>
                <td>根清单：列出两份数据集当前版本号、分片索引与完整快照地址</td>
                <td>最多每小时一次</td>
              </tr>
              <tr>
                <td><code>/data/agents/README.md</code></td>
                <td>给 Agent 读的查询与回答说明；Skill 用的也是它</td>
                <td>需要时</td>
              </tr>
              <tr>
                <td><code>/data/agents/schema.json</code></td>
                <td>企业实体与业务画像字段的 JSON Schema 定义</td>
                <td>需要时</td>
              </tr>
              <tr>
                <td><a href={new URL(giants.index.url).pathname} target='_blank' rel='noopener noreferrer'><code>little-giants/.../index.json</code></a></td>
                <td>专精特新“小巨人”各省份统计与分片地址（共 {giants.recordCount.toLocaleString('zh-CN')} 家，快照 {giants.snapshotDate}）</td>
                <td>版本不变永久复用</td>
              </tr>
              <tr>
                <td><a href={new URL(unicorns.index.url).pathname} target='_blank' rel='noopener noreferrer'><code>unicorns/.../index.json</code></a></td>
                <td>胡润全球独角兽各国统计与分片地址（共 {unicorns.recordCount.toLocaleString('zh-CN')} 家，快照 {unicorns.snapshotDate}）</td>
                <td>版本不变永久复用</td>
              </tr>
              <tr>
                <td><code>.../parts/0001.json</code></td>
                <td>单个省份或国家的企业分块（每片最多 100 家）</td>
                <td>版本不变永久复用</td>
              </tr>
              <tr>
                <td>
                  <a href={new URL(giants.snapshot.url).pathname} target='_blank' rel='noopener noreferrer'><code>little-giants 快照</code></a>
                  {' · '}
                  <a href={new URL(unicorns.snapshot.url).pathname} target='_blank' rel='noopener noreferrer'><code>unicorns 快照</code></a>
                </td>
                <td>单份完整快照 JSON，适合首次离线建库或全量统计</td>
                <td>只在第一次</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 目前做不到的 -->
    <section class='hub-section limit-section' aria-labelledby='limits-title'>
      <h2 id='limits-title'>目前做不到的</h2>
      <ul class='limit-list'>
        <li>只有发布时点的客观快照（2025 年第七批小巨人公示名单、2026 胡润独角兽榜），没有实时工商变更与实时估值。</li>
        <li>没有招聘岗位与薪资数据，不能直接查“某公司现在招不招产品经理”；筛出候选公司后请到企业官网或招聘平台核对。</li>
        <li>部分企业暂未补充主营业务简介或官网，搜不到某个关键词不代表该公司没有这块业务。</li>
      </ul>
    </section>

    <!-- 接入资源 -->
    <section class='hub-section' aria-labelledby='resources-title'>
      <h2 id='resources-title' class='section-h2'>接入资源</h2>
      <div class='resource-grid'>
        <a class='resource-card' href='/llms.txt' target='_blank' rel='noopener noreferrer'>
          <strong>llms.txt</strong>
          <span>给大模型读的站点说明</span>
        </a>
        <a class='resource-card' href='/data/agents/README.md' target='_blank' rel='noopener noreferrer'>
          <strong>Agent 使用说明</strong>
          <span>Agent 读了就能查，Skill 用的也是它</span>
        </a>
        <a class='resource-card' href='/data/agents/skill/README.md' target='_blank' rel='noopener noreferrer'>
          <strong>Skill 安装包说明</strong>
          <span>安装方式与 SKILL.md 原文</span>
        </a>
        <a class='resource-card' href='/data/agents/manifest.json' target='_blank' rel='noopener noreferrer'>
          <strong>Manifest 根清单</strong>
          <span>当前数据版本与地区分片入口</span>
        </a>
        <a class='resource-card' href='/data/agents/schema.json' target='_blank' rel='noopener noreferrer'>
          <strong>JSON Schema</strong>
          <span>企业与业务画像字段定义 · 1.0</span>
        </a>
      </div>
    </section>

    <aside class='hub-notice hub-section'>
      个人求职调研、学术研究和团队内部行研可免费使用。名单资格与历史估值以原发布机构说明为准；引用分析结论时请保留快照日期与公开来源链接，详见 <a class='hub-link' href='/terms'>站点政策</a>。
    </aside>
  </main>
</PageLayout>

<style>
  .agent-hero {
    margin-bottom: 1.5rem;
  }
  .agent-status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    font-size: 0.75rem;
    padding: 0.22rem 0.62rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--muted) / 0.45);
    color: hsl(var(--muted-foreground));
  }
  .status-chip.ok {
    color: #15803d;
    border-color: rgb(21 128 61 / 0.28);
    background: rgb(21 128 61 / 0.08);
    font-weight: 500;
  }
  :global(.dark) .status-chip.ok {
    color: #4ade80;
    border-color: rgb(74 222 128 / 0.3);
    background: rgb(74 222 128 / 0.1);
  }
  .status-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
  }

  /* 顶部 3 张方式切换卡 */
  .mode-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
  }
  .mode-card {
    text-align: left;
    padding: 1rem 1.05rem;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .mode-card:hover {
    border-color: hsl(var(--primary) / 0.5);
    background: hsl(var(--muted) / 0.25);
  }
