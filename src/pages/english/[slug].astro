---
// 引入基础页面布局组件
import PageLayout from '@/layouts/BaseLayout.astro'
// 引入 Pure 基础按钮组件
import { Button } from 'astro-pure/user'
// 引入英语课程数据获取函数及类型
import { getEnglishLessons, type EnglishLessonItem } from '@/data/content-helpers'

export const prerender = true

// 生成全部课程的静态路由路径
export async function getStaticPaths() {
  const lessons = getEnglishLessons()
  return lessons.map((lesson: EnglishLessonItem, index: number) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      index: index + 1,
      prev: index > 0 ? lessons[index - 1] : null,
      next: index < lessons.length - 1 ? lessons[index + 1] : null
    }
  }))
}

interface Props {
  lesson: EnglishLessonItem
  index: number
  prev: EnglishLessonItem | null
  next: EnglishLessonItem | null
}

const { lesson, index, prev, next } = Astro.props

const meta = {
  title: `${lesson.title} · 出海工作英语 · 良逍`,
  description: lesson.summary || lesson.goal
}
---

<PageLayout {meta}>
  {/* 返回列表按钮与课程序号标注 */}
  <div class='flex items-center justify-between'>
    <Button title='返回英语课程' href='/english' variant='back' />
    <span class='font-mono text-xs font-medium text-primary'>Lesson {String(index).padStart(2, '0')}</span>
  </div>

  <article class='mt-6 w-full lg:mt-8'>
    {/* 课件主容器：挂载 data-english-player 属性与默认隐藏中文设置 */}
    <div
      class='lesson-courseware-container animate'
      data-english-player
      data-translations-default='hidden'
    >
      <div class='lesson-courseware'>
        {/* 动态渲染完整的课件 HTML（包含 Header, Setup, Hint, Dialogue 与单句点读按钮, Expressions, Patterns, My Turn） */}
        <Fragment set:html={lesson.coursewareHtml || lesson.bodyHtml} />

        {/* 课程完成状态记录操作 */}
        <div class='lesson-progress-actions my-8 flex justify-center'>
          <button
            type='button'
            class='mark-complete'
            data-mark-complete
            aria-pressed='false'
          >
            标记本课完成
          </button>
        </div>
      </div>

      {/* 供 speech-player.js 驱动点读与语速控制的 JSON 数据节点 */}
      <script
        id='english-player-data'
        type='application/json'
        set:html={JSON.stringify(
          lesson.playerData || {
            id: lesson.id,
            revision: lesson.revision || 'v1',
            sentences: lesson.sentences || []
          }
        )}
      />

      {/* 载入官方离线语音点读播放器驱动脚本 */}
      <script is:inline src='/site-assets/speech-player.js'></script>
    </div>

    {/* 上一课 / 下一课平滑导航 */}
    <footer class='mt-12 border-t border-border/70 pt-6'>
      <div class='grid grid-cols-2 gap-4 text-sm'>
        <div>
          {
            prev && (
              <a
                href={`/english/${prev.slug}/`}
                class='group flex flex-col gap-1 rounded-lg border border-border/60 p-3 transition-all hover:border-primary/40 hover:bg-muted/30'
              >
                <span class='text-xs text-muted-foreground'>← 上一课</span>
                <span class='truncate font-medium text-foreground transition-colors group-hover:text-primary'>
                  {prev.title}
                </span>
              </a>
            )
          }
        </div>
        <div class='text-right'>
          {
            next && (
              <a
                href={`/english/${next.slug}/`}
                class='group flex flex-col gap-1 rounded-lg border border-border/60 p-3 transition-all hover:border-primary/40 hover:bg-muted/30'
              >
                <span class='text-xs text-muted-foreground'>下一课 →</span>
                <span class='truncate font-medium text-foreground transition-colors group-hover:text-primary'>
                  {next.title}
                </span>
              </a>
            )
          }
        </div>
      </div>
    </footer>
  </article>
</PageLayout>

<style is:global>
  /* 课件专属样式系统：完美契合 Pure 主题的深浅色变量规范 */
  .lesson-courseware header h1 {
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.5rem;
    color: hsl(var(--foreground));
  }
  @media (min-width: 640px) {
    .lesson-courseware header h1 {
      font-size: 2rem;
    }
  }
  .lesson-courseware header h1 .en {
    display: block;
    font-size: 1rem;
    font-weight: 400;
    color: hsl(var(--muted-foreground));
    margin-top: 0.25rem;
  }
  .lesson-courseware header .meta {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  .lesson-courseware header .task {
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background-color: hsl(var(--primary) / 0.08);
    border: 1px solid hsl(var(--primary) / 0.2);
    color: hsl(var(--foreground));
    margin-bottom: 1.5rem;
  }

  /* 场景 Setup 网格 */
  .lesson-courseware .setup-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  @media (min-width: 640px) {
    .lesson-courseware .setup-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lesson-courseware .setup-item {
    background-color: hsl(var(--muted) / 0.5);
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
  }
  .lesson-courseware .setup-item h3 {
    margin: 0 0 0.375rem;
    font-size: 0.75rem;
    color: hsl(var(--primary));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .lesson-courseware .setup-item .en {
    font-size: 0.875rem;
    color: hsl(var(--foreground));
    line-height: 1.5;
  }
  .lesson-courseware .setup-item .cn {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    margin-top: 0.375rem;
    line-height: 1.5;
  }

  /* 通用按钮与控制条 */
  .lesson-courseware button:not(.primary),
  .lesson-courseware select {
    color: hsl(var(--foreground));
    background-color: hsl(var(--muted) / 0.8);
    border: 1px solid hsl(var(--border) / 0.85);
    border-radius: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lesson-courseware button:hover,
  .lesson-courseware select:hover {
    border-color: hsl(var(--primary) / 0.6);
    background-color: hsl(var(--muted));
  }

  .lesson-courseware .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 1rem 0;
  }
  .lesson-courseware .controls button.primary {
    background-color: hsl(var(--primary));
    color: hsl(var(--background));
    border: 1px solid hsl(var(--primary));
    border-radius: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lesson-courseware .controls button.primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .lesson-courseware .controls label {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* 对话列表与逐句点读 */
  .lesson-courseware .dialogue {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
  }
  .lesson-courseware .line {
    padding: 0.875rem 0;
    border-top: 1px dashed hsl(var(--border) / 0.8);
    transition: background-color 0.2s ease;
  }
  .lesson-courseware .line:first-child {
    border-top: none;
    padding-top: 0.25rem;
  }
  .lesson-courseware .line.is-playing {
    background-color: hsl(var(--primary) / 0.08);
    border-radius: 0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  .lesson-courseware .line-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }
  .lesson-courseware .speaker {
    font-weight: 600;
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    background-color: hsl(var(--muted));
    border: 1px solid hsl(var(--border) / 0.7);
    color: hsl(var(--muted-foreground));
  }
  .lesson-courseware .play-line {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    border: 1px solid hsl(var(--border) / 0.8);
    background-color: hsl(var(--background));
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lesson-courseware .play-line:hover {
    border-color: hsl(var(--primary));
  }
  .lesson-courseware .play-line.playing {
    background-color: hsl(var(--primary)) !important;
    color: hsl(var(--background)) !important;
    border-color: hsl(var(--primary)) !important;
  }
  .lesson-courseware .en-line {
    margin: 0.25rem 0;
    font-size: 0.95rem;
    color: hsl(var(--foreground));
    line-height: 1.6;
    font-weight: 450;
  }
  .lesson-courseware .cn-line {
    margin: 0.25rem 0 0;
    font-size: 0.825rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }

  /* 显隐工具类 */
  .lesson-courseware .hidden {
    display: none !important;
  }

  /* 重点表达与实用句型卡片 */
  .lesson-courseware .expr,
  .lesson-courseware .pat,
  .lesson-courseware .my-turn-body {
    background-color: hsl(var(--muted) / 0.35);
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 0.75rem;
    padding: 0.875rem 1.125rem;
    margin: 0 0 0.875rem;
  }
  .lesson-courseware .expr h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.375rem;
    color: hsl(var(--foreground));
  }
  .lesson-courseware .expr .ipa {
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    font-weight: 400;
    margin-left: 0.375rem;
  }
  .lesson-courseware .expr .def {
    margin: 0.25rem 0;
    font-size: 0.825rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.5;
  }
  .lesson-courseware .expr .def strong {
    color: hsl(var(--foreground));
  }
  .lesson-courseware .pat strong {
    color: hsl(var(--primary));
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
  }
  .lesson-courseware .pat .use {
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    display: block;
    margin-top: 0.25rem;
  }

  /* My Turn 与参考答案 */
  .lesson-courseware .reveal {
    background-color: hsl(var(--primary));
    color: hsl(var(--background));
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: opacity 0.2s ease;
  }
  .lesson-courseware .reveal:hover {
    opacity: 0.9;
  }
  .lesson-courseware .answer {
    margin-top: 0.875rem;
    padding: 0.875rem;
    border-left: 3px solid hsl(var(--primary));
    background-color: hsl(var(--muted) / 0.6);
    border-radius: 0.5rem;
  }
  .lesson-courseware .answer p {
    margin: 0.25rem 0;
    font-size: 0.85rem;
    color: hsl(var(--foreground));
    line-height: 1.5;
  }
  .lesson-courseware .answer .note {
    font-size: 0.775rem;
    color: hsl(var(--muted-foreground));
    margin-top: 0.5rem;
  }

  /* 提示与完成按钮 */
  .lesson-courseware .footer-tip {
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    text-align: center;
    padding: 1.5rem 0 0;
  }
  .lesson-courseware .voice-warn {
    color: hsl(var(--primary));
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }
  .lesson-courseware-container .mark-complete {
    background-color: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 0.625rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--foreground));
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lesson-courseware-container .mark-complete:hover {
    border-color: hsl(var(--primary));
    background-color: hsl(var(--primary) / 0.1);
  }
  .lesson-courseware-container .mark-complete[aria-pressed='true'] {
    background-color: hsl(var(--primary));
    color: hsl(var(--background));
    border-color: hsl(var(--primary));
  }

  /* 盲听复习模式样式适配 */
  body.blind .lesson-courseware .expressions,
  body.blind .lesson-courseware .patterns,
  body.blind .lesson-courseware .my-turn,
  body.blind .lesson-courseware .setup,
  body.blind .lesson-courseware .dialogue-section .dialogue,
  body.blind .lesson-courseware .dialogue-section .controls .play-all,
  body.blind .lesson-courseware .dialogue-section .controls .stop,
  body.blind .lesson-courseware .dialogue-section .controls .speed,
  body.blind .lesson-courseware .dialogue-section .controls .voice,
  body.blind .lesson-courseware .dialogue-section .controls .toggle-dialogue {
    display: none !important;
  }
</style>
