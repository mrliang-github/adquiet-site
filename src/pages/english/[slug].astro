---
import PageLayout from '@/layouts/BaseLayout.astro'
import { Button } from 'astro-pure/user'
import { getEnglishLessons, type EnglishLessonItem, type EnglishExpression, type EnglishSentence } from '@/data/content-helpers'

export const prerender = true

export async function getStaticPaths() {
  const lessons = getEnglishLessons()
  return lessons.map((lesson: EnglishLessonItem, index: number) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      index: index + 1,
      prev: index > 0 ? lessons[index - 1] : null,
      next: index < lessons.length - 1 ? lessons[index + 1] : null
    }
  }))
}

interface Props {
  lesson: EnglishLessonItem
  index: number
  prev: EnglishLessonItem | null
  next: EnglishLessonItem | null
}

const { lesson, index, prev, next } = Astro.props

const meta = {
  title: `${lesson.title} · 出海工作英语`,
  description: lesson.summary || lesson.goal
}
---

<PageLayout {meta}>
  <Button title='返回课程列表' href='/english' variant='back' />

  <article class='mt-6 lg:mt-10 animate'>
    <!-- Header -->
    <header class='border-b border-border/60 pb-6'>
      <div class='flex flex-wrap items-center gap-3 text-sm text-muted-foreground'>
        <span class='font-mono font-medium text-primary'>Lesson {String(index).padStart(2, '0')}</span>
        <span>•</span>
        <span>出海独立开发实战英语</span>
        {lesson.durationMinutes && (
          <>
            <span>•</span>
            <span class='flex items-center gap-1'>
              ⏱️ {lesson.durationMinutes} 分钟完成
            </span>
          </>
        )}
      </div>
      <h1 class='mt-3 text-2xl font-medium sm:text-3xl leading-snug'>
        {lesson.title}
      </h1>
      <p class='mt-3 text-sm text-muted-foreground leading-relaxed'>
        {lesson.summary}
      </p>
    </header>

    <!-- Context & Goal Callout -->
    <div class='grid gap-4 sm:grid-cols-2 my-6'>
      {lesson.scenario && (
        <div class='rounded-2xl border border-border/70 bg-muted/30 p-4'>
          <h2 class='text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1'>
            📍 真实场景
          </h2>
          <p class='text-sm text-foreground/90 leading-relaxed'>{lesson.scenario}</p>
        </div>
      )}
      {lesson.goal && (
        <div class='rounded-2xl border border-primary/20 bg-primary/5 p-4'>
          <h2 class='text-xs font-semibold uppercase tracking-wider text-primary mb-1'>
            🎯 沟通目标
          </h2>
          <p class='text-sm text-foreground/90 leading-relaxed'>{lesson.goal}</p>
        </div>
      )}
    </div>

    <!-- Expressions Section -->
    {lesson.expressions && lesson.expressions.length > 0 && (
      <section class='my-8'>
        <h2 class='text-lg font-medium text-foreground mb-4 flex items-center gap-2'>
          <span>📌 核心短语与地道表达</span>
        </h2>
        <div class='grid gap-3'>
          {lesson.expressions.map((exp: EnglishExpression) => (
            <div class='rounded-xl border border-border/70 p-4'>
              <div class='flex flex-wrap items-baseline justify-between gap-2'>
                <span class='font-mono text-base font-semibold text-primary'>{exp.phrase}</span>
                <span class='text-xs text-muted-foreground'>{exp.meaning || exp.translation}</span>
              </div>
              {exp.example && (
                <div class='mt-2.5 rounded-lg bg-muted/50 p-2.5 text-xs space-y-1 font-mono'>
                  <p class='text-foreground/90'>{exp.example}</p>
                  {(exp.chineseExample) && (
                    <p class='text-muted-foreground font-sans'>{exp.chineseExample}</p>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Sentences / Dialogue Section -->
    {lesson.sentences && lesson.sentences.length > 0 && (
      <section class='my-8'>
        <h2 class='text-lg font-medium text-foreground mb-4 flex items-center gap-2'>
          <span>💬 实战情境逐句对照</span>
        </h2>
        <div class='space-y-3'>
          {lesson.sentences.map((sent: EnglishSentence, idx: number) => (
            <div class='rounded-xl border border-border/60 p-4 transition-colors hover:border-border'>
              <div class='flex items-start gap-3'>
                <span class='flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[11px] font-mono font-medium text-muted-foreground mt-0.5'>
                  {idx + 1}
                </span>
                <div class='space-y-1 flex-1'>
                  {sent.speaker && (
                    <span class='text-xs font-semibold uppercase text-primary tracking-wide block'>
                      {sent.speaker}
                    </span>
                  )}
                  <p class='text-sm font-medium text-foreground leading-relaxed'>{sent.english}</p>
                  <p class='text-xs text-muted-foreground leading-relaxed'>{sent.chinese}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Main HTML Body if available -->
    {lesson.bodyHtml && (
      <section class='prose prose-neutral dark:prose-invert max-w-none my-8 pt-4 border-t border-border/40'>
        <Fragment set:html={lesson.bodyHtml} />
      </section>
    )}

    <!-- Practice Section -->
    {lesson.practice && (
      <section class='my-6 rounded-2xl border border-primary/30 bg-primary/5 p-5'>
        <h2 class='text-sm font-semibold text-primary mb-2 flex items-center gap-2'>
          <span>✍️ 动手演练 (Practice)</span>
        </h2>
        <p class='text-sm text-foreground/90 leading-relaxed'>{lesson.practice}</p>
      </section>
    )}

    <!-- Navigation Footer -->
    <footer class='mt-10 border-t border-border/60 pt-6'>
      <div class='grid grid-cols-2 gap-4 text-sm'>
        <div>
          {prev && (
            <a
              href={`/english/${prev.slug}/`}
              class='group flex flex-col gap-1 rounded-lg p-2 transition-colors hover:bg-muted'
            >
              <span class='text-xs text-muted-foreground'>← 上一课</span>
              <span class='truncate font-medium text-foreground group-hover:text-primary'>
                {prev.title}
              </span>
            </a>
          )}
        </div>
        <div class='text-right'>
          {next && (
            <a
              href={`/english/${next.slug}/`}
              class='group flex flex-col gap-1 rounded-lg p-2 transition-colors hover:bg-muted'
            >
              <span class='text-xs text-muted-foreground'>下一课 →</span>
              <span class='truncate font-medium text-foreground group-hover:text-primary'>
                {next.title}
              </span>
            </a>
          )}
        </div>
      </div>
    </footer>
  </article>
</PageLayout>
