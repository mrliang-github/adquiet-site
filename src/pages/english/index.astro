---
import PageLayout from '@/layouts/BaseLayout.astro'
import { Button } from 'astro-pure/user'
import { getEnglishLessons, type EnglishLessonItem, type EnglishExpression } from '@/data/content-helpers'

export const prerender = true

const lessons = getEnglishLessons()

const meta = {
  title: '出海独立开发工作英语',
  description: '面向出海开发者、产品经理的高频业务场景实战英文：从 Bug 回复、合同协商到催款与用户沟通'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-6 mt-6 sm:mt-10'>
        <h1 class='text-3xl font-medium'>出海独立开发工作英语</h1>
        <p class='mt-2 text-muted-foreground text-sm max-w-2xl leading-relaxed'>
          不背冷门单词，只练真实场景。整理自出海沟通中的真实场景：处理 Bug 反馈、协商赞助合作、催讨发票、澄清产品边界与用户访谈。共 {lessons.length} 个高频场景。
        </p>
      </div>
    </div>

    <section aria-label='英语课程列表' class='animate mt-8'>
      <div class='grid gap-4 sm:grid-cols-2'>
        {
          lessons.map((lesson: EnglishLessonItem, idx: number) => (
            <article class='group hover-card-lift flex flex-col justify-between rounded-2xl border border-border/70 p-5 transition-all hover:bg-muted/30'>
              <div>
                <div class='flex items-center justify-between text-xs text-muted-foreground mb-2'>
                  <span class='font-mono font-medium text-primary'>
                    Lesson {String(idx + 1).padStart(2, '0')}
                  </span>
                  {lesson.durationMinutes && (
                    <span class='flex items-center gap-1 text-[11px]'>
                      ⏱️ {lesson.durationMinutes} 分钟
                    </span>
                  )}
                </div>

                <h2 class='text-base font-medium tracking-tight text-foreground group-hover:text-primary transition-colors'>
                  <a href={`/english/${lesson.slug}/`}>
                    {lesson.title}
                  </a>
                </h2>

                <p class='mt-2 text-xs text-muted-foreground leading-relaxed line-clamp-2'>
                  {lesson.summary || lesson.scenario}
                </p>

                {lesson.expressions && lesson.expressions.length > 0 && (
                  <div class='mt-3 flex flex-wrap gap-1.5'>
                    {lesson.expressions.slice(0, 3).map((exp: EnglishExpression) => (
                      <span class='rounded-md border border-border/60 bg-muted/70 px-2.5 py-1 text-xs font-mono text-foreground/80'>
                        {exp.phrase}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class='mt-4 pt-3 border-t border-border/40 flex items-center justify-between text-xs'>
                <span class='text-muted-foreground truncate max-w-[200px]'>
                  {lesson.goal || '实战会话演练'}
                </span>
                <a
                  href={`/english/${lesson.slug}/`}
                  class='font-medium text-primary hover:underline shrink-0'
                >
                  开始学习 →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</PageLayout>
