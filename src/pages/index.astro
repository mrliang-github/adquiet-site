                </p>

                {/* 最新 3 节动态列表：采用语义化 ul/li，每行可直达单课跟读页 */}
                <ul class='mt-3.5 space-y-2 border-t border-border/45 pt-3' aria-label='近期职场英语课程'>
                  {latestEnglishLessons.map((lesson) => (
                    <li class='min-w-0'>
                      <a
                        href={lesson.href}
                        class='group flex items-center gap-2 rounded-sm px-1.5 py-1 -mx-1.5 text-xs transition-colors hover:bg-muted/60'
                      >
                        {/* 左侧固定课号徽章 */}
