---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import { projects, type ProjectItem } from '@/data/projects'
import { guides } from '@/data/guides'
import { articleTopics, articleTopicHref } from '@/data/article-topics'
import config from '@/site-config'
import heroBanner from '@/assets/hero-banner.jpg'
import avatarImg from '@/assets/avatar.png'
import shengcaiQrcode from '@/assets/shengcai-qrcode.png'
import '../styles/catalog.css'

export const prerender = true
const featuredProjects = ['听页', 'Fluxio 视频压缩裁切', 'PDF Snap', '发票识别工作台']
  .map((name) => projects.find((project) => project.name === name))
  .filter((project): project is ProjectItem => project !== undefined)
const featuredGuides = guides.filter(({ href }) => [
  '/blog/mac-invoice-ocr/',
  '/blog/xiaohongshu-comment-intelligence/',
  '/blog/codex-google-sheets-store-upload/'
].includes(href))
const articleHomeTitles: Record<string, string> = {
  'grok-bot-workflows': '我怎样给 5 个 Bot 分工',
  'wordpress-security-review': '一次 WordPress 独立站安全复盘',
  'codex-app-production-line': '把两个 App 的送审流程串起来',
  'two-lark-work-cards': '给 Codex 接入公司和个人两套飞书',
  'chatgpt-codex-work-notes': '新版桌面端里的 Chat、Work 和 Codex',
  'xiaohongshu-comment-intelligence': '把小红书评论整理成产品需求线索'
}
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
const latestPosts = posts.slice(0, 6)
  .map(({ id, data }) => ({
    title: articleHomeTitles[id] ?? data.title,
    href: `/blog/${id}`,
    date: data.publishDate,
    description: data.description,
    topic: articleTopics.find(topic => data.tags.includes(topic.toLowerCase())) ?? data.tags[0]
  }))
const topics = articleTopics.map(topic => ({
  title: topic,
  href: articleTopicHref(topic),
  count: posts.filter(({ data }) => data.tags.includes(topic.toLowerCase())).length
})).filter(topic => topic.count > 0)
---

{/* 页面主布局：设定湖山青碧蓝 (#54889C) 为主题高光色 */}
<PageLayout
  meta={{
    title: '首页 · 良逍',
    description: '良逍的个人网站。这里放着我做的 App 和网页工具，也记录 AI 工作流、文件处理和产品开发中的实践。'
  }}
  highlightColor='#54889C'
>
  <main class='flex w-full flex-col items-center' data-pagefind-body>
    {/* 统一规范容器：最大宽度限制为 max-w-4xl，严格统一左右基线对齐 */}
    <div class='flex w-full max-w-4xl flex-col items-center'>
      
      {/* 1. Header Profile Hero：与顶部吸顶导航保留舒展自然的呼吸空间，视野开阔不局促 */}
      <div class='animate mt-1 sm:mt-3 mb-8 w-full sm:mb-12'>
        {/* 顶部湖山天际线全景横幅：多增加 px 圆角 (12px~16px)，限定仅鼠标真正移入横幅本身时触发动效 */}
        <div class='hero-banner-container group relative h-52 w-full overflow-hidden rounded-xl sm:rounded-2xl cursor-pointer sm:h-64 md:h-76 ring-1 ring-border/50 transition-all duration-300 hover:ring-primary/40'>
          {/* 横幅全景原图：仅平滑微景深展开 (1.035)，纯粹几何缩放，严格保持原图自然光影不变明变暗 */}
          <Image
            src={heroBanner}
            alt='湖山与城市天际线全景'
            class='hero-banner-image h-full w-full object-cover object-center filter brightness-[0.98] contrast-[1.02] transition-transform duration-600 ease-out group-hover:scale-[1.035] will-change-transform dark:brightness-[0.76]'
            loading='eager'
            fetchpriority='high'
          />
          {/* 底部渐变透明遮罩：pointer-events-none 确保鼠标事件穿透给横幅容器，与页面主底色无缝融为一体 */}
          <div class='absolute inset-0 bg-gradient-to-b from-transparent via-background/20 to-background pointer-events-none'></div>
        </div>

        {/* 头像与身份定位区：自然悬浮于横幅地平线交界，无拘束通透排布 */}
        <section class='relative -mt-16 flex flex-col items-center gap-y-3.5 px-4 text-center sm:-mt-20 sm:gap-y-4' id='content-header'>
          {/* 圆形头像：环境光晕厚边框与微悬浮动效 */}
          <div class='relative'>
            <Image
              src={avatarImg}
              alt={config.author}
              class='size-28 rounded-full border-4 border-background bg-background object-cover shadow-xl ring-2 ring-border/70 transition-all duration-300 hover:scale-105 hover:ring-primary/60 hover:shadow-primary/20 sm:size-32'
              loading='eager'
              fetchpriority='high'
            />
          </div>

          {/* 名字与真实定位 */}
          <div class='flex flex-col items-center gap-y-1.5'>
            <h1 class='text-2xl font-bold tracking-tight text-foreground sm:text-3xl'>你好，我是良逍</h1>
            <p class='text-sm text-muted-foreground'>
              学的是设计，做的是产品。
            </p>
            <p class='max-w-xl text-sm leading-relaxed text-muted-foreground'>
              主业做跨境电商相关的 CMS、ERP 系统，工作之外用 AI 做一些 App 和网页工具。
            </p>
            <p class='max-w-xl text-sm leading-relaxed text-muted-foreground'>
              这里放着我做的产品，也记录用过的方法和遇到的问题。
            </p>
          </div>

          {/* 核心社交与实战合作标签：严肃正式矩形微圆角质感 (rounded-md) */}
          <div class='flex flex-wrap items-center justify-center gap-2.5 text-xs'>
            {/* 商务交流与微信号标签 */}
            <div
              class='flex items-center gap-x-2 rounded-md border border-border/80 bg-background/90 px-3 py-1.5 font-mono text-muted-foreground shadow-xs transition-colors hover:border-primary/50 hover:text-foreground'
              title='微信联系'
            >
              <span class='font-sans font-medium text-primary'>微信</span>
              <span>liangxiao-20</span>
            </div>

            {/* GitHub 链接 */}
            <Label
              title='GitHub'
              as='a'
              href='https://github.com/mrliang-github'
              target='_blank'
              class='rounded-md'
            >
              <Icon name='github' class='size-3.5' slot='icon' />
            </Label>

            {/* X (Twitter) 链接 */}
            <Label
              title='X (Twitter)'
              as='a'
              href='https://x.com/lingxio71220285'
              target='_blank'
              class='rounded-md'
            >
              <Icon name='x' class='size-3.5' slot='icon' />
            </Label>
          </div>

          <div class='flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm'>
            <Button title='看产品与工具 →' href='/projects' variant='ahead' />
            <Button title='看实用攻略 →' href='/guides/' variant='ahead' />
          </div>
        </section>
      </div>

      {/* 2. 主体内容区块组：严格与 Hero 容器同宽（max-w-4xl 100%），统一垂直间距节奏 gap-y-12 sm:gap-y-16 */}
      <div id='content' class='animate flex w-full flex-col gap-y-12 sm:gap-y-16'>
        
        <Section title='产品与工具' desc='阅读、视频处理和文件整理'>
          <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
            {
              featuredProjects.map((p: ProjectItem) => (
                /* 产品卡片：容器统一为 rounded-lg 现代克制矩形微圆角，内层徽标为 rounded-md 精致微圆角标签 */
                <a
                  href={p.href}
                  target={p.external ? '_blank' : undefined}
                  rel={p.external ? 'noopener noreferrer' : undefined}
                  class='group hover-card-lift flex flex-col justify-between rounded-md border border-border/70 p-4 transition-all hover:bg-muted/30 sm:p-5'
                >
                  <div>
                    <div class='mb-2.5 flex items-center justify-between text-xs text-muted-foreground'>
                      {/* 分类标签：rounded-md 矩形微圆角 */}
                      <span class='rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-mono text-xs font-medium text-primary'>{p.category}</span>
                      {/* 状态徽标：rounded-md 规范 */}
                      <span class='rounded-md border border-border/60 bg-muted/80 px-2.5 py-0.5 text-xs font-normal text-muted-foreground'>{p.status}</span>
                    </div>
                    <h3 class='text-base font-medium text-foreground transition-colors group-hover:text-primary'>
                      {p.name}
                    </h3>
                    <p class='mt-1.5 text-xs leading-relaxed text-muted-foreground'>
                      {p.description}
                    </p>
                  </div>
                  <div class='mt-3.5 flex items-center justify-end text-xs font-medium text-primary'>
                    <span>查看中国区商店 ↗</span>
                  </div>
                </a>
              ))
            }
          </div>
          <Button title='查看全部产品与工具 →' class='w-fit self-end text-xs' href='/projects' variant='ahead' />
        </Section>

        <section class='hub-entry' aria-labelledby='home-articles-title'>
          <div class='mb-5 flex flex-wrap items-baseline justify-between gap-2'>
            <div><h2 id='home-articles-title' class='text-xl font-semibold'>公众号文章</h2><p class='mt-2 max-w-xl text-sm leading-relaxed text-muted-foreground'>我在公众号写的 AI 工具、产品实践和建站记录，也放在这里，方便按主题查找。</p></div>
            <a class='hub-link text-sm' href='/blog'>全部 {posts.length} 篇 →</a>
          </div>
          <nav class='mb-5 flex flex-wrap gap-2' aria-label='按主题阅读文章'>
            {topics.map(topic => <a href={topic.href} class='inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-xs transition-colors hover:border-primary/50 hover:text-primary'><span>{topic.title}</span><span class='text-muted-foreground'>{topic.count}</span></a>)}
          </nav>
          <ul class='grid gap-4 sm:grid-cols-2' aria-label='近期公众号文章'>
            {latestPosts.map(post => (
              <li class='min-w-0'>
                <a class='group flex h-full flex-col rounded-md border border-border/70 p-5 transition-colors hover:border-primary/50 hover:bg-muted/30' href={post.href}>
                  <div class='mb-3 flex flex-wrap items-center justify-between gap-2 text-xs'>
                    <span class='text-primary'>{post.topic}</span>
                    <time class='font-mono text-muted-foreground' datetime={post.date.toISOString()}>{post.date.toISOString().slice(0, 10)}</time>
                  </div>
                  <h3 class='text-base font-medium leading-relaxed transition-colors group-hover:text-primary'>{post.title}</h3>
                  <p class='mt-2 flex-1 text-sm leading-relaxed text-muted-foreground'>{post.description}</p>
                  <span class='mt-4 text-xs text-primary'>阅读全文 →</span>
                </a>
              </li>
            ))}
          </ul>
          <div class='mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm'>
            <a class='hub-link' href='/notes/'>全部笔记 →</a>
            <a class='hub-link' href='/daily'>风向标整理 →</a>
            <a class='hub-link' href='/english'>英语学习 →</a>
          </div>
        </section>

        <section class='hub-entry' aria-labelledby='home-guides-title'>
          <div class='mb-5 flex flex-wrap items-baseline justify-between gap-2'>
            <div><h2 id='home-guides-title' class='text-xl font-semibold'>精选攻略</h2><p class='mt-2 text-sm text-muted-foreground'>整理文件、收集需求、维护产品资料时用到的方法。</p></div>
            <a class='hub-link text-sm' href='/guides/'>浏览全部攻略 →</a>
          </div>
          <div class='hub-home-grid'>
            {featuredGuides.map(g => <a class='hub-card' href={g.href}><span class='hub-badge'>{g.category}</span><h3>{g.title}</h3><p>{g.description}</p><span class='hub-card-action'>阅读攻略 →</span></a>)}
          </div>
        </section>

        <section aria-label='生财有术体验入口' class='overflow-hidden rounded-md border border-emerald-500/30 bg-gradient-to-br from-emerald-500/10 via-background to-primary/5 p-4.5 sm:p-6 shadow-sm transition-all hover:border-emerald-500/50'>
          <div class='flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between'>
            {/* 左侧文案与行动按钮 */}
            <div class='flex flex-1 flex-col gap-y-2.5'>
              <div class='flex items-center gap-x-2'>
                <span class='rounded-md border border-emerald-500/30 bg-emerald-500/15 px-2.5 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400'>
                  生财有术
                </span>
              </div>
              <h3 class='text-base font-semibold text-foreground sm:text-lg'>
                了解生财有术
              </h3>
              <p class='text-xs leading-relaxed text-muted-foreground sm:text-sm'>
                我也会在生财有术看项目案例、参与交流。如果想了解这个社区，可以通过下面的入口查看体验卡说明。
              </p>
              <div class='mt-1 flex flex-wrap items-center gap-3 pt-1'>
                <a
                  href='https://work.weixin.qq.com/ct/wcde8c6272cb42775a69efd3c537aa631fb4'
                  target='_blank'
                  rel='noopener noreferrer'
                  class='inline-flex items-center gap-x-1.5 rounded-md bg-emerald-600 px-4 py-1.5 text-xs font-medium text-white shadow-xs transition-all hover:bg-emerald-700 hover:shadow-md'
                >
                  <span>查看体验卡说明 ↗</span>
                </a>
              </div>
            </div>

            {/* 社区体验入口二维码 */}
            <div class='flex items-center justify-around gap-4 border-t border-border/50 pt-4 sm:border-t-0 sm:border-l sm:pl-6 sm:pt-0 shrink-0'>
              <div class='flex flex-col items-center gap-y-1.5'>
                <div class='overflow-hidden rounded-md border border-border/80 bg-white p-1.5 shadow-xs'>
                  <Image
                    src={shengcaiQrcode}
                    alt='生财有术体验入口二维码'
                    class='size-20 sm:size-22 object-contain'
                    loading='lazy'
                  />
                </div>
                <span class='text-[11px] text-muted-foreground'>微信扫码查看</span>
              </div>
            </div>
          </div>
        </section>
      </div>

    </div>
  </main>
</PageLayout>
