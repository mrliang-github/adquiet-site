---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getPostCategory, postCategoryDefinitions } from '@/data/article-topics'
import { catalogBySlug, catalogs } from '@/data/catalog'
// 引入风向标日报与职场英语的数据读取工具，用于在首页「探索与日常」楼层动态渲染最新条目
import { getDailyReports, getEnglishLessonsByDate } from '@/data/content-helpers'
// 引入产品清单、平台分组定义与按钮文案生成工具
import { getProjectCtaLabel, projectGroupDefinitions, projects } from '@/data/projects'
// 引入统一维护的微信公众号与联系信息配置
import { wechatOfficialAccount } from '@/data/wechat'
import config from '@/site-config'
import heroBanner from '@/assets/hero-banner.jpg'
import avatarImg from '@/assets/avatar.png'
import shengcaiQrcode from '@/assets/shengcai-qrcode.png'
// 引入公众号后台导出的官方二维码图片资源
import wechatMpQrcode from '@/assets/wechat-mp-qrcode.jpg'
import '../styles/catalog.css'

export const prerender = true

// 1. 组装首页产品筛选胶囊数据：不写死具体总款数，避免给访客造成“只做过这些”的错觉
const projectFilters = [
  { label: '精选代表作', key: 'featured' },
  ...projectGroupDefinitions.map((group) => ({
    label: group.shortLabel,
    key: group.key
  })),
  { label: '已公开汇总', key: 'all' }
]

// 2. 首页精选文章显示别名
const articleHomeTitles: Record<string, string> = {
  '100-lines-python-agent': '不用 LangChain：100 行原生 Python 跑通你的第一个本地 Agent',
  'grok-bot-workflows': '我怎样给 5 个 Bot 分工',
  'wordpress-security-review': '一次 WordPress 独立站安全复盘',
  'codex-app-production-line': '把两个 App 的送审流程串起来',
  'two-lark-work-cards': '给 Codex 接入公司和个人两套飞书',
  'chatgpt-codex-work-notes': '新版桌面端里的 Chat、Work 和 Codex',
  'xiaohongshu-comment-intelligence': '把小红书评论整理成产品需求线索',
  'mac-invoice-ocr': 'Mac 发票转 Excel：先识别，再复核'
}

// 3. 企业数据库动态元数据统计
const giantsMeta = catalogBySlug('little-giants')!.metadata
const unicornsMeta = catalogBySlug('unicorns')!.metadata
const totalCompanies = catalogs.reduce((sum, item) => sum + item.metadata.count, 0)

// 4. 读取所有博客文章并按发布时间倒序排列
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

const formattedPosts = allPosts.map(({ id, data }) => {
  const { category, key } = getPostCategory(data.tags)
  return {
    id,
    title: articleHomeTitles[id] ?? data.title,
    href: `/blog/${id}/`,
    date: data.publishDate,
    description: data.description,
    category,
    categoryKey: key,
    tag: data.tags[0] || category
  }
})

// 分类筛选药丸数据定义
const categoryFilters = [
  { label: '全部', key: 'all', count: allPosts.length },
  ...postCategoryDefinitions.map((def) => ({
    label: def.label,
    key: def.key,
    count: formattedPosts.filter((p) => p.categoryKey === def.key).length
  }))
].filter((c) => c.key === 'all' || c.count > 0)

// 5. 读取「每日风向标」与「职场英语」全量列表，并提取最新 3 条用于首页动态预览
const allDailyReports = getDailyReports()
const latestDailyReports = allDailyReports.slice(0, 3).map((report) => {
  // 如果日报主标题是通用日期格式，则优先取第一条具体商业案例标题并清理话题井号
  const rawFirstDiscovery = report.discoveries?.[0]?.title?.replace(/#[^#]+#/g, '').trim()
  const displayTitle =
    report.title.startsWith('风向标日报') && rawFirstDiscovery ? rawFirstDiscovery : report.title
  return {
    // 跳转到对应日报详情页的路径
    href: `/daily/${report.slug}/`,
    // 完整日期（用于语义化 time 标签）
    editionDate: report.editionDate,
    // 截取月-日用于紧凑列表展示（如 10-01）
    shortDate: report.editionDate.slice(5),
    // 最终展示的一句话案例标题
    title: displayTitle
  }
})

const allEnglishLessons = getEnglishLessonsByDate()
const latestEnglishLessons = allEnglishLessons.slice(0, 3).map((lesson) => ({
  // 跳转到对应英语情景课详情页的路径
  href: `/english/${lesson.slug}/`,
  // 格式化固定课号徽章（如 L27）
  lessonCode: `L${String(lesson.lessonNumber ?? 1).padStart(2, '0')}`,
  // 课程完整双语标题（列表内单行截断展示）
  title: lesson.title
}))
---

{/* 页面主布局：设定湖山青碧蓝 (#54889C) 为主题高光色 */}
<PageLayout
  meta={{
    title: '首页 · 良逍',
    description: '良逍的个人网站。这里放着我做的 App 和网页工具，也记录 AI 工作流、文件处理和产品开发中的实践。'
  }}
  highlightColor='#54889C'
>
  <main class='flex w-full flex-col items-center' data-pagefind-body>
    {/* 统一规范容器：最大宽度限制为 max-w-4xl，严格统一左右基线对齐 */}
    <div class='flex w-full max-w-4xl flex-col items-center'>
      
      {/* 1. Header Profile Hero：Banner 和头像区 100% 保持原样不动 */}
      <div class='animate mt-1 sm:mt-3 mb-8 w-full sm:mb-12'>
        {/* 顶部湖山天际线全景横幅 */}
        <div class='hero-banner-container group relative h-52 w-full overflow-hidden rounded-xl sm:rounded-2xl cursor-pointer sm:h-64 md:h-76 ring-1 ring-border/50 transition-all duration-300 hover:ring-primary/40'>
          <Image
            src={heroBanner}
            alt='湖山与城市天际线全景'
            class='hero-banner-image h-full w-full object-cover object-center filter brightness-[0.98] contrast-[1.02] transition-transform duration-600 ease-out group-hover:scale-[1.035] will-change-transform dark:brightness-[0.76]'
            loading='eager'
            fetchpriority='high'
          />
          <div class='absolute inset-0 bg-gradient-to-b from-transparent via-background/20 to-background pointer-events-none'></div>
        </div>

        {/* 头像与身份定位区：自然悬浮于横幅地平线交界 */}
        <section class='relative -mt-16 flex flex-col items-center gap-y-3.5 px-4 text-center sm:-mt-20 sm:gap-y-4' id='content-header'>
          <div class='relative'>
            <Image
              src={avatarImg}
              alt={config.author}
              class='size-28 rounded-full border-4 border-background bg-background object-cover shadow-xl ring-2 ring-border/70 transition-all duration-300 hover:scale-105 hover:ring-primary/60 hover:shadow-primary/20 sm:size-32'
              loading='eager'
              fetchpriority='high'
            />
          </div>

          {/* 名字与真实定位 */}
          <div class='flex flex-col items-center gap-y-1.5'>
            <h1 class='text-2xl font-bold tracking-tight text-foreground sm:text-3xl'>你好，我是良逍</h1>
            <p class='text-sm text-muted-foreground'>
              学的是设计，做的是产品。
            </p>
            <p class='max-w-xl text-sm leading-relaxed text-muted-foreground'>
              主业做跨境电商相关的 CMS、ERP 系统，工作之外用 AI 做一些 App 和网页工具。
            </p>
            <p class='max-w-xl text-sm leading-relaxed text-muted-foreground'>
              这里放着我做的产品，也记录用过的方法和遇到的问题。
            </p>
          </div>

          {/* 核心社交与实战合作标签：并列提供公众号低门槛关注入口与个人合作微信 */}
          <div class='flex flex-wrap items-center justify-center gap-2.5 text-xs'>
            {/* 点击打开原生模态框查看公众号高清二维码与复制名称 */}
            <button
              type='button'
              id='open-wechat-mp-dialog'
              class='inline-flex cursor-pointer items-center gap-x-2 rounded-md border border-primary/35 bg-primary/8 px-3 py-1.5 text-xs text-foreground shadow-xs transition-colors hover:border-primary/65 hover:bg-primary/14'
            >
              <span class='font-medium text-primary'>公众号</span>
              <span class='font-medium'>{wechatOfficialAccount.name}</span>
              <span class='rounded-sm bg-primary/15 px-1.5 py-0.5 text-[10px] font-medium text-primary'>扫码</span>
            </button>

            {/* 个人合作微信号展示胶囊 */}
            <div
              class='flex items-center gap-x-2 rounded-md border border-border/80 bg-background/90 px-3 py-1.5 font-mono text-muted-foreground shadow-xs transition-colors hover:border-primary/50 hover:text-foreground'
            >
              <span class='font-sans font-medium text-primary'>微信</span>
              <span>{wechatOfficialAccount.personalWechat}</span>
            </div>

            <Label
              title='GitHub'
              as='a'
              href='https://github.com/mrliang-github'
              target='_blank'
              class='rounded-md'
            >
              <Icon name='github' class='size-3.5' slot='icon' />
            </Label>

            <Label
              title='X (Twitter)'
              as='a'
              href='https://x.com/lingxio71220285'
              target='_blank'
              class='rounded-md'
            >
              <Icon name='x' class='size-3.5' slot='icon' />
            </Label>
          </div>

          {/* 公众号二维码原生模态框：支持 Esc 关闭、背景点击关闭与名称一键复制 */}
          <dialog
            id='wechat-mp-dialog'
            closedby='any'
            aria-labelledby='wechat-mp-dialog-title'
            class='wechat-mp-dialog m-auto w-[min(92vw,22rem)] rounded-xl border border-border bg-background p-5 text-center text-foreground shadow-xl'
          >
            <div class='flex flex-col items-center gap-y-3'>
              <span class='rounded-md border border-primary/25 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
                微信公众号
              </span>
              <h2 id='wechat-mp-dialog-title' class='text-lg font-semibold text-foreground'>
                {wechatOfficialAccount.name}
              </h2>
              <p class='text-xs leading-relaxed text-muted-foreground'>
                {wechatOfficialAccount.description}
              </p>

              {/* 首屏隐藏于模态框内的二维码保留 fetchpriority="low"，空闲时静默预载，点击弹窗即刻满帧呈现 */}
              <div class='my-1 overflow-hidden rounded-lg border border-border/80 bg-white p-2 shadow-xs'>
                <Image
                  src={wechatMpQrcode}
                  alt={`${wechatOfficialAccount.name}公众号二维码`}
                  width={160}
                  height={160}
                  fetchpriority='low'
                  class='size-40 object-contain'
                />
              </div>

              <p class='font-mono text-[11px] text-muted-foreground'>
                微信号：{wechatOfficialAccount.accountId}
              </p>

              {/* 底部按钮行：一键复制名称 + 原生 form[method=dialog] 安全关闭 */}
              <div class='mt-1 flex w-full items-center justify-center gap-2.5'>
                <button
                  type='button'
                  data-copy-mp-name={wechatOfficialAccount.name}
                  class='inline-flex flex-1 cursor-pointer items-center justify-center rounded-md bg-primary px-3 py-2 text-xs font-medium text-primary-foreground transition-opacity hover:opacity-90'
                >
                  <span data-copy-mp-label>复制公众号名称</span>
                </button>
                <form method='dialog' class='shrink-0'>
                  <button
                    type='submit'
                    class='inline-flex cursor-pointer items-center justify-center rounded-md border border-border px-3.5 py-2 text-xs text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground'
                  >
                    关闭
                  </button>
                </form>
              </div>
            </div>
          </dialog>

          <div class='flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm'>
            <Button title='看产品与工具 →' href='/projects' variant='ahead' />
            <Button title='查潜力公司库 →' href='/data' variant='ahead' />
          </div>
        </section>
      </div>

      {/* 2. 主体内容区块组：严格与 Hero 容器同宽（max-w-4xl 100%），统一垂直间距节奏 */}
      <div id='content' class='animate flex w-full flex-col gap-y-12 sm:gap-y-16'>
        
        {/* [楼层 2] 产品与工具：默认展示 6 款主力代表作，支持按平台胶囊原地切换浏览部分公开作品 */}
        <section class='hub-entry' aria-labelledby='home-projects-title'>
          <div class='mb-5 flex flex-wrap items-baseline justify-between gap-2'>
            <div>
              <div class='flex items-center gap-x-2'>
                <span class='rounded-md border border-primary/25 bg-primary/10 px-2.5 py-0.5 font-mono text-xs font-medium text-primary'>独立产品矩阵</span>
                <span class='font-mono text-xs text-muted-foreground'>部分公开产品与工具</span>
              </div>
              <h2 id='home-projects-title' class='mt-2 text-xl font-semibold text-foreground'>产品与工具</h2>
              <p class='mt-1.5 max-w-xl text-sm leading-relaxed text-muted-foreground'>
                覆盖 Apple Watch、iPhone、Mac 与浏览器的实用小工具，围绕录音转写、阅读听书、量房、发票复核与文件处理，核心操作尽量留在设备本地完成。
              </p>
            </div>
            <a class='hub-link text-sm' href='/projects'>查看产品与工具页 →</a>
          </div>

          {/* 平台分类筛选胶囊：支持免跳转查看 iOS / macOS / Web 各端公开产品 */}
          <nav class='mb-5 flex flex-wrap gap-2' aria-label='按平台筛选产品与工具'>
            {projectFilters.map((filter) => (
              <button
                type='button'
                data-project-filter={filter.key}
                aria-pressed={filter.key === 'featured' ? 'true' : 'false'}
                class:list={[
                  'category-pill inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-xs transition-colors',
                  filter.key === 'featured' ? 'active' : ''
                ]}
              >
                <span>{filter.label}</span>
              </button>
            ))}
          </nav>

          {/* 全量渲染 16 款产品卡片，默认展示精选 6 款，点击胶囊切换平台分组 */}
          <ul class='grid grid-cols-1 gap-4 sm:grid-cols-2' aria-label='产品与工具列表'>
            {
              projects.map((p) => (
                <li
                  class='min-w-0'
                  data-project-card
                  data-project-group={p.group}
                  data-project-featured={p.featured ? 'true' : 'false'}
                  style={p.featured ? undefined : 'display: none;'}
                >
                  <a
                    href={p.href}
                    target={p.external ? '_blank' : undefined}
                    rel={p.external ? 'noopener noreferrer' : undefined}
                    class='group hover-card-lift flex h-full flex-col justify-between rounded-md border border-border/75 bg-background/85 p-4.5 transition-all hover:border-primary/50 hover:bg-muted/30 sm:p-5'
                  >
                    <div>
                      {/* 卡片头部：左侧圆角应用图标 + 右侧产品名与状态胶囊 */}
                      <div class='flex items-start gap-3.5'>
                        <img
                          src={p.icon}
                          alt=''
                          width='44'
                          height='44'
                          loading='lazy'
                          fetchpriority={p.featured ? undefined : 'low'}
                          class='size-11 shrink-0 rounded-xl border border-border/60 bg-muted/20 object-cover shadow-2xs'
                        />
                        <div class='min-w-0 flex-1'>
                          <h3 class='text-base font-semibold leading-snug text-foreground transition-colors group-hover:text-primary'>
                            {p.name}
                          </h3>
                          <div class='mt-1.5 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground'>
                            <span class='rounded-md border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-[11px] font-medium text-primary'>
                              {p.category}
                            </span>
                            <span class='rounded-md border border-border/60 bg-muted/80 px-2 py-0.5 text-[11px] font-normal text-muted-foreground'>
                              {p.status}
                            </span>
                          </div>
                        </div>
                      </div>

                      {/* 一句话产品核心用途 */}
                      <p class='mt-3 text-xs leading-relaxed text-muted-foreground'>
                        {p.description}
                      </p>

                      {/* 精准适用人群与高频场景 */}
                      <p class='mt-2.5 rounded-sm border border-border/45 bg-muted/40 px-2.5 py-1.5 text-[11px] leading-snug text-muted-foreground'>
                        <span class='font-medium text-foreground/85'>适合谁用：</span>
                        <span>{p.audience}</span>
                      </p>
                    </div>

                    <div class='mt-3.5 flex items-center justify-end border-t border-border/40 pt-2.5 text-xs font-medium text-primary'>
                      <span class='group-hover:underline'>{getProjectCtaLabel(p)}</span>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>

          <div class='mt-4 flex items-center justify-end text-xs'>
            <a class='hub-link' href='/projects'>查看更多公开产品与开源仓库 →</a>
          </div>
        </section>

        {/* [楼层 3] 潜力公司库（新增独立楼层，亮出核心企业数据资产与 Agent 接口） */}
        <section class='hub-entry' aria-labelledby='home-data-title'>
          <div class='mb-5 flex flex-wrap items-baseline justify-between gap-2'>
            <div>
              <div class='flex items-center gap-x-2'>
                <span class='rounded-md border border-primary/25 bg-primary/10 px-2.5 py-0.5 font-mono text-xs font-medium text-primary'>企业数据资产</span>
                <span class='text-xs text-muted-foreground font-mono'>{totalCompanies.toLocaleString('zh-CN')} 家企业收录</span>
              </div>
              <h2 id='home-data-title' class='mt-2 text-xl font-semibold text-foreground'>潜力公司库</h2>
              <p class='mt-1.5 max-w-xl text-sm leading-relaxed text-muted-foreground'>
                整理专精特新“小巨人”公示名单与胡润全球独角兽企业快照，支持按省市、赛道多维穿透筛选，并开放机器可读的 Agent 数据网关。
              </p>
            </div>
            <a class='hub-link text-sm' href='/data'>进入公司库主页 →</a>
          </div>

          {/* 两个大卡片并排：小巨人 vs 独角兽 */}
          <div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
            {/* 卡片 1: 专精特新小巨人 */}
            <a href={`/data/${giantsMeta.slug}/`} class='group flex flex-col justify-between rounded-md border border-border/80 bg-background/90 p-5 transition-all hover:border-primary/60 hover:bg-muted/30 hover:shadow-xs'>
              <div>
                <div class='flex items-center justify-between text-xs'>
                  <span class='rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>国家级公示名录</span>
                  <span class='font-mono text-muted-foreground'>快照 {giantsMeta.snapshotDate}</span>
                </div>
                <h3 class='mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary'>专精特新“小巨人”企业查询</h3>
                <div class='mt-2 flex items-baseline gap-x-2'>
                  <span class='text-2xl font-bold font-mono tracking-tight text-foreground'>{giantsMeta.count.toLocaleString('zh-CN')}</span>
                  <span class='text-xs text-muted-foreground'>家收录企业 · {giantsMeta.profileCount.toLocaleString('zh-CN')} 家含主营业务画像</span>
                </div>
                <p class='mt-2.5 text-xs leading-relaxed text-muted-foreground'>
                  收录 {giantsMeta.year} 年第七批新增公示名单全国整理版。支持按省份、申报地区和业务领域检索，溯源官方公示依据，查看主营业务画像。
                </p>
              </div>
              <div class='mt-4 flex items-center justify-between border-t border-border/50 pt-3 text-xs'>
                <span class='text-muted-foreground'>支持筛选链接与 CSV 导出</span>
                <span class='font-medium text-primary group-hover:underline'>在线检索名录 →</span>
              </div>
            </a>

            {/* 卡片 2: 胡润独角兽榜单 */}
            <a href={`/data/${unicornsMeta.slug}/`} class='group flex flex-col justify-between rounded-md border border-border/80 bg-background/90 p-5 transition-all hover:border-primary/60 hover:bg-muted/30 hover:shadow-xs'>
              <div>
                <div class='flex items-center justify-between text-xs'>
                  <span class='rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>胡润全球独角兽</span>
                  <span class='font-mono text-muted-foreground'>估值基准 {unicornsMeta.valuationDate.slice(0, 7)}</span>
                </div>
                <h3 class='mt-3 text-lg font-semibold text-foreground transition-colors group-hover:text-primary'>胡润全球独角兽榜查询</h3>
                <div class='mt-2 flex items-baseline gap-x-2'>
                  <span class='text-2xl font-bold font-mono tracking-tight text-foreground'>{unicornsMeta.count.toLocaleString('zh-CN')}</span>
                  <span class='text-xs text-muted-foreground'>家收录企业 · 人民币亿元估值基准</span>
                </div>
                <p class='mt-2.5 text-xs leading-relaxed text-muted-foreground'>
                  聚合全球估值 10 亿美元以上核心企业画像。支持按行业赛道、国家地区多维穿透，查看历史估值、负责人信息与主营业务。
                </p>
              </div>
              <div class='mt-4 flex items-center justify-between border-t border-border/50 pt-3 text-xs'>
