<style>
  .category-pill {
    border-color: hsl(var(--border));
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    cursor: pointer;
    user-select: none;
  }
  .category-pill:hover {
    border-color: hsl(var(--primary) / 0.5);
    color: hsl(var(--foreground));
  }
  .category-pill.active {
    border-color: hsl(var(--primary));
    background-color: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    font-weight: 600;
  }
  /* 原生公众号模态框背景遮罩层样式 */
  .wechat-mp-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  // 初始化首页产品与工具平台筛选胶囊交互
  function setupProjectFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')
    const cards = document.querySelectorAll<HTMLElement>('[data-project-card]')

    pills.forEach((pill) => {
      // 避免客户端路由切换后重复注册事件
      if (pill.dataset.bound === 'true') return
      pill.dataset.bound = 'true'
      pill.addEventListener('click', () => {
        const filterKey = pill.dataset.projectFilter
        // 同步更新胶囊选中态与无障碍 aria-pressed 属性
        pills.forEach((p) => {
          p.classList.remove('active')
          p.setAttribute('aria-pressed', 'false')
        })
        pill.classList.add('active')
        pill.setAttribute('aria-pressed', 'true')

        // 按所选分组筛选可见的产品卡片
        cards.forEach((card) => {
          const groupKey = card.dataset.projectGroup
          const isFeatured = card.dataset.projectFeatured === 'true'

          if (filterKey === 'featured') {
            card.style.display = isFeatured ? '' : 'none'
          } else if (filterKey === 'all') {
            card.style.display = ''
          } else {
            card.style.display = groupKey === filterKey ? '' : 'none'
          }
        })
      })
    })
  }

  // 初始化首页公众号二维码模态框打开、背景点击关闭与名称复制交互
  function setupWechatDialog() {
    const openBtn = document.getElementById('open-wechat-mp-dialog')
    const dialog = document.getElementById('wechat-mp-dialog') as HTMLDialogElement | null
    if (!openBtn || !dialog) return

    if (openBtn.dataset.bound !== 'true') {
      openBtn.dataset.bound = 'true'
      openBtn.addEventListener('click', () => {
        // 调用原生 showModal() 锁定焦点并激活顶层遮罩
        dialog.showModal()
      })

      // 为尚未支持 closedby="any" 的旧浏览器提供点击模态框外部遮罩关闭的回退逻辑
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close()
        }
      })
    }

    // 绑定模态框内的一键复制公众号名称按钮
    const copyBtn = dialog.querySelector<HTMLButtonElement>('[data-copy-mp-name]')
    const copyLabel = dialog.querySelector<HTMLElement>('[data-copy-mp-label]')
    if (copyBtn && copyLabel && copyBtn.dataset.bound !== 'true') {
      copyBtn.dataset.bound = 'true'
      copyBtn.addEventListener('click', async () => {
        const mpName = copyBtn.dataset.copyMpName || ''
        const prevText = copyLabel.textContent || '复制公众号名称'
        try {
          await navigator.clipboard.writeText(mpName)
          copyLabel.textContent = '已复制，去微信搜一搜 ✓'
          setTimeout(() => {
            copyLabel.textContent = prevText
          }, 2200)
        } catch {
          copyLabel.textContent = `请搜：${mpName}`
        }
      })
    }
  }

  function setupArticleFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>('[data-post-filter]')
    const cards = document.querySelectorAll<HTMLElement>('[data-post-card]')

    pills.forEach((pill) => {
      if (pill.dataset.bound === 'true') return
      pill.dataset.bound = 'true'
      pill.addEventListener('click', () => {
        const filterKey = pill.dataset.postFilter
        pills.forEach((p) => p.classList.remove('active'))
        pill.classList.add('active')

        cards.forEach((card) => {
          const categoryKey = card.dataset.postCategory
          const isDefault = card.dataset.default === 'true'

          if (filterKey === 'all') {
            card.style.display = isDefault ? '' : 'none'
          } else {
            card.style.display = categoryKey === filterKey ? '' : 'none'
          }
        })
      })
    })
  }

  // 统一挂载首页交互逻辑
  function initHomePage() {
    setupProjectFilter()
    setupWechatDialog()
    setupArticleFilter()
  }

  initHomePage()
  document.addEventListener('astro:page-load', initHomePage)
</script>
