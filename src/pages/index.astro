    cursor: pointer;
    user-select: none;
  }
  .category-pill:hover {
    border-color: hsl(var(--primary) / 0.5);
    color: hsl(var(--foreground));
  }
  .category-pill.active {
    border-color: hsl(var(--primary));
    background-color: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    font-weight: 600;
  }
</style>

<script>
  function setupArticleFilter() {
    const pills = document.querySelectorAll<HTMLButtonElement>('[data-post-filter]')
    const cards = document.querySelectorAll<HTMLElement>('[data-post-card]')

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        const filterKey = pill.dataset.postFilter
        pills.forEach(p => p.classList.remove('active'))
        pill.classList.add('active')

        let matchCount = 0
        cards.forEach(card => {
          const categoryKey = card.dataset.postCategory
          const isDefault = card.dataset.default === 'true'

          if (filterKey === 'all') {
            card.style.display = isDefault ? '' : 'none'
          } else {
            if (categoryKey === filterKey && matchCount < 6) {
              card.style.display = ''
              matchCount++
            } else {
              card.style.display = 'none'
            }
          }
        })
      })
    })
  }

  setupArticleFilter()
  document.addEventListener('astro:page-load', setupArticleFilter)
</script>
