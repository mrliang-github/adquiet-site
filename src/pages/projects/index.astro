---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import { projects } from '@/data/projects'

export const prerender = true

const iosProjects = projects.filter((p) => p.group === 'ios')
const macProjects = projects.filter((p) => p.group === 'macos')
const webProjects = projects.filter((p) => p.group === 'web')

const headings = [
  { depth: 2, slug: 'ios-apps', text: `iOS 与 Apple Watch 应用（${iosProjects.length}）` },
  { depth: 2, slug: 'macos-apps', text: `macOS 桌面应用（${macProjects.length}）` },
  { depth: 2, slug: 'web-and-open', text: `网页工具、扩展与开源项目（${webProjects.length}）` },
  { depth: 2, slug: 'app-policy', text: '应用支持与合规' }
]
---

<PageLayout title='产品与工具' {headings} view>
  <div class='not-prose mb-6 flex flex-wrap items-center justify-between gap-3'>
    <p class='text-sm text-muted-foreground'>
      把想法做成能用的东西。目前维护 {projects.length} 款 iOS、Apple Watch、macOS 与 Web 工具，按实际分发渠道标注上架状态。
    </p>
    <a
      href='https://github.com/mrliang-github'
      target='_blank'
      rel='noopener noreferrer'
      class='flex items-center gap-x-2 rounded-lg border bg-background px-3 py-1.5 text-xs text-muted-foreground shadow-sm transition-all hover:text-foreground hover:shadow no-underline'
    >
      <span class='size-2 rounded-full bg-emerald-500'></span>
      <span class='font-medium'>GitHub @mrliang-github</span>
    </a>
  </div>

  <p class='text-sm text-muted-foreground mb-2'>GitHub 活跃动态：</p>
  <div class='overflow-x-auto my-3'>
    <img
      src='https://ghchart.rshah.org/54889c/mrliang-github'
      alt='github activities'
      class='max-w-full rounded border border-border/80 p-2 bg-muted/20'
      loading='lazy'
    />
  </div>

  <h2 id='ios-apps'>iOS 与 Apple Watch 应用</h2>
  <p class='text-sm text-muted-foreground leading-relaxed mb-4'>
    围绕录音转写、阅读听书、量房、视频与文件整理等高频个人场景开发，核心处理尽量留在设备本地完成。
  </p>
  <ProjectSection projects={iosProjects} class='my-4' />

  <h2 id='macos-apps'>macOS 桌面应用</h2>
  <p class='text-sm text-muted-foreground leading-relaxed mb-4'>
    解决日常办公发票核对、菜单栏图标检索与机身发热诊断的小工具。
  </p>
  <ProjectSection projects={macProjects} class='my-4' />

  <h2 id='web-and-open'>网页工具、扩展与开源项目</h2>
  <p class='text-sm text-muted-foreground leading-relaxed mb-4'>
    打开浏览器就能用的排版、格式转换工具，以及浏览器扩展和开源 AI Skill。
  </p>
  <ProjectSection projects={webProjects} class='my-4' />

  <h2 id='app-policy'>应用支持与合规</h2>
  <p class='text-sm text-muted-foreground leading-relaxed'>
    站内托管的产品主页、隐私政策与技术支持入口：
  </p>
  <div class='grid gap-3.5 sm:grid-cols-2 not-prose my-4'>
    <div class='rounded-lg border border-border/70 p-4.5 bg-muted/20'>
      <h3 class='text-sm font-semibold text-foreground mb-1'>OtterBar (macOS)</h3>
      <p class='text-xs text-muted-foreground mb-3'>菜单栏工具快速搜索</p>
      <div class='flex gap-2 text-xs'>
        <a href='/otterbar/' class='text-primary hover:underline'>产品主页与下载</a>
      </div>
    </div>
    <div class='rounded-lg border border-border/70 p-4.5 bg-muted/20'>
      <h3 class='text-sm font-semibold text-foreground mb-1'>HeatSleuth (macOS)</h3>
      <p class='text-xs text-muted-foreground mb-3'>发热与高负载诊断工具</p>
      <div class='flex gap-2 text-xs'>
        <a href='/heatsleuth/zh/' class='text-primary hover:underline'>中文产品主页与下载</a>
        <span>·</span>
        <a href='/heatsleuth/' class='text-muted-foreground hover:text-foreground hover:underline'>English</a>
      </div>
    </div>
    <div class='rounded-lg border border-border/70 p-4.5 bg-muted/20'>
      <h3 class='text-sm font-semibold text-foreground mb-1'>PDF Snap (iOS 应用)</h3>
      <p class='text-xs text-muted-foreground mb-3'>离线 PDF 实用工具</p>
      <div class='flex gap-2 text-xs'>
        <a href='/pdf-snap/privacy/' class='text-primary hover:underline'>隐私政策</a>
        <span>·</span>
        <a href='/pdf-snap/support/' class='text-primary hover:underline'>技术支持</a>
      </div>
    </div>
    <div class='rounded-lg border border-border/70 p-4.5 bg-muted/20'>
      <h3 class='text-sm font-semibold text-foreground mb-1'>AdQuiet (Chrome 扩展)</h3>
      <p class='text-xs text-muted-foreground mb-3'>纯净视频播放扩展</p>
      <div class='flex gap-2 text-xs'>
        <a href='/adquiet/' class='text-primary hover:underline'>扩展介绍</a>
        <span>·</span>
        <a href='/adquiet/privacy/' class='text-primary hover:underline'>隐私政策</a>
        <span>·</span>
        <a href='/adquiet/support/' class='text-primary hover:underline'>技术支持</a>
      </div>
    </div>
  </div>
</PageLayout>
